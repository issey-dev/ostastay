generator client {
  provider = "prisma-client-js"
}

// PostgreSQL since 2026-08-02. SQLite serialises every write behind a single lock,
// which is the wrong shape for a PMS where several front-desk users post charges at
// once; Postgres also gives real online backups (pg_dump) and row-level concurrency.
//
// The move required squashing the 90 SQLite migrations into the single baseline in
// prisma/migrations/: their DDL was SQLite-specific and could never replay here. The
// old history is preserved in git (see the commit that introduced this line), and no
// deployment had data at the time of the switch.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// EnterpriseType: STANDARD (a real customer), INTERNAL (exactly one row — Osta's own
// support enterprise; its users get no implicit access to any other enterprise's data,
// only time-boxed access via an approved SupportAccessGrant)
model Enterprise {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // url-safe, used by /e/{slug}/login
  type      String   @default("STANDARD")
  createdAt DateTime @default(now())

  properties            Property[]
  taxProfiles           TaxProfile[]
  chargeGroups          ChargeGroup[]
  chargeSubgroups       ChargeSubgroup[]
  chargeCodes           ChargeCode[]
  chargeCodeGenerates   ChargeCodeGenerate[]
  paymentMethods        PaymentMethod[]
  profiles              Profile[]
  cashierShifts         CashierShift[]
  settings              EnterpriseSettings?
  users                 User[]
  roles                 Role[]
  nightAuditLogs        NightAuditLog[]
  systemCodes           SystemCode[]
  roomAttendants        RoomAttendant[]
  license               EnterpriseLicense?
  licenseInvoices       LicenseInvoice[]
  channelConnections    ChannelConnection[]
  channelSyncLogs       ChannelSyncLog[]
  channelInboundBookings ChannelInboundBooking[]
  jobRuns               JobRun[]
  eRegistrationLinks    ERegistrationLink[]
  addonAccess           EnterpriseAddonAccess[]

  supportGrantsReceived SupportAccessGrant[] @relation("GrantTarget")
}

// Tier: STANDARD, PRO, MAX — governs maxProperties today; TierModuleAccess is a
// scaffold for future module gating by tier (not enforced yet).
model EnterpriseLicense {
  id            String     @id @default(uuid())
  enterpriseId  String     @unique
  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  // VESTIGIAL (2026-07-31, owner decisions): tiers price nothing (manual monthlyPrice
  // below) and, with TierModuleAccess removed, gate nothing either. The column survives
  // only because many rows/tests reference it; drop in a later cleanup migration. Do
  // not surface it anywhere or key any behaviour off it.
  tier          String     @default("STANDARD")
  maxProperties Int        @default(1)
  notes         String?

  // SaaS lifecycle. status: ACTIVE | REVOKED (revoke is an explicit Osta act, distinct
  // from expiry). Validity = status ACTIVE && (expiresAt null || now <= expiresAt);
  // between expiresAt and expiresAt+graceDays users may still sign in but see a payment
  // warning; after grace they are locked out at login AND at requireSession (so live
  // sessions die too). Osta/internal users and a missing license row are exempt — the
  // row is created lazily and absence must not brick a tenant (same fail-open stance as
  // TierModuleAccess).
  status     String    @default("ACTIVE")
  validFrom  DateTime?
  expiresAt  DateTime?
  graceDays  Int       @default(7)
  // Manual monthly price (owner decision: no formula) — the four attribute caps
  // (maxProperties above + PropertyLicenseAllowance) restrict, they don't price.
  monthlyPrice  Float?
  priceCurrency String @default("USD")

  updatedAt DateTime @updatedAt
}

// Per-property attribute caps (owner decision 2026-07-31: allowances are per property,
// not enterprise totals). Null = unlimited for that attribute; 0 = attribute disallowed.
// Pseudo (PM) room types and their rooms NEVER count against these caps, and PM room
// types are refused channel mapping outright — see src/lib/license.ts.
model PropertyLicenseAllowance {
  id         String   @id @default(uuid())
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  maxRoomTypes Int?
  maxRooms     Int?
  maxChannels  Int?

  updatedAt DateTime @updatedAt
}

// A licensing invoice Osta issues to a client enterprise (the platform's own paper —
// branded via /osta/controls, NOT any property's stationery). status: ISSUED | PAID |
// VOID. Marking paid stamps paidAt + receiptNo, which is what the payment receipt
// document renders from — one row is both the invoice and, once settled, its receipt.
model LicenseInvoice {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  invoiceNo   String   @unique
  periodStart DateTime
  periodEnd   DateTime
  // amount is the NET payable after discount; discountAmount is shown on the printed
  // invoice as goodwill (list price = amount + discountAmount). Display-only — no
  // percentage math anywhere.
  amount         Float
  discountAmount Float  @default(0)
  currency       String @default("USD")
  status      String   @default("ISSUED")
  issuedAt    DateTime @default(now())
  dueAt       DateTime?

  paidAt           DateTime?
  paymentReference String?
  receiptNo        String? @unique

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enterpriseId, issuedAt])
}

// REMOVED 2026-07-31 (owner): TierModuleAccess and EnterpriseModuleAccess are gone —
// which modules a tenant uses "is not controlled by us." Module availability is now the
// tenant's own role-permission matrix; Osta's control surface is the license itself
// (validity, price, per-property attribute caps — see EnterpriseLicense and
// PropertyLicenseAllowance). Sellable add-ons (Spa, Excursions) are a different
// mechanism and remain, enterprise-scoped since 2026-08-02 — see EnterpriseAddonAccess.

// A Role always belongs to a real Enterprise — system/default roles belong to the one
// INTERNAL "Osta" enterprise (isSystem = true) rather than a nullable enterpriseId, so
// the (enterpriseId, name) unique index behaves correctly (SQLite treats every NULL as
// distinct, which would silently allow duplicate "shared" role names otherwise).
// "Roles visible to enterprise X" = X's own roles UNION Osta's isSystem roles.
model Role {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  name         String
  isSystem     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  permissions RolePermission[]
  users       User[]

  @@unique([enterpriseId, name])
}

// Module: FRONT_DESK, RESERVATIONS, GROUP_BLOCKS, TAPE_CHART, PROFILES, HOUSEKEEPING,
// MAINTENANCE, CASHIERING, POS, NIGHT_AUDIT, REVENUE, REPORTS, CONTROLS
model RolePermission {
  id        String  @id @default(uuid())
  roleId    String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([roleId, module])
}

// Status: PENDING, APPROVED, DENIED, REVOKED, EXPIRED
// requestedBy is always an Osta (INTERNAL enterprise) user; approvedBy is always a user
// of the target enterprise. See src/lib/scope.ts for how an APPROVED grant is exchanged
// for a short-lived "acting as" session.
model SupportAccessGrant {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation("GrantTarget", fields: [enterpriseId], references: [id], onDelete: Cascade)

  requestedByUserId String
  requestedBy       User    @relation("GrantRequestedBy", fields: [requestedByUserId], references: [id])
  approvedByUserId  String?
  approvedBy        User?   @relation("GrantApprovedBy", fields: [approvedByUserId], references: [id])

  status      String    @default("PENDING")
  reason      String?
  requestedAt DateTime  @default(now())
  respondedAt DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?

  @@index([approvedByUserId])
  @@index([enterpriseId])
  @@index([requestedByUserId])
}

model SystemCode {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  category     String // e.g., "GENDER", "TITLE", "DIETARY_REQ"
  code         String // e.g., "M", "F", "VEGAN"
  value        String // The display label
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)

  @@unique([enterpriseId, category, code])
}

model NightAuditLog {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  auditDate   DateTime // The system date that was audited
  runByUserId String

  foliosUpdated    Int     @default(0)
  noShowsProcessed Int     @default(0)
  status           String  @default("SUCCESS") // SUCCESS, FAILED
  notes            String?

  createdAt DateTime @default(now())

  @@index([enterpriseId])
}

// Scope: ENTERPRISE (sees every Property under the Enterprise) | PROPERTY (a single
// work-location Property, set via propertyId). roleId replaces the old free-text role.
model User {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  scope        String     @default("ENTERPRISE")
  propertyId   String?
  property     Property?  @relation("UserWorkLocation", fields: [propertyId], references: [id])
  isActive     Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomAttendant       RoomAttendant?
  assignedRooms       Room[]            @relation("RoomAssignedAttendant")
  assignedMaintenance RoomMaintenance[] @relation("MaintenanceAssignedTo")

  supportGrantsRequested   SupportAccessGrant[] @relation("GrantRequestedBy")
  supportGrantsApproved    SupportAccessGrant[] @relation("GrantApprovedBy")
  currencyExchangesCreated CurrencyExchange[]   @relation("CurrencyExchangeCreatedBy")
  propertiesReviewed       Property[]           @relation("PropertyReviewedBy")
  spaTherapistProfile      SpaTherapist?        @relation("SpaTherapistUser")

  @@index([enterpriseId])
  @@index([propertyId])
  @@index([roleId])
}

// PropertyStatus: PENDING (newly created by a tenant, not yet reviewed — locked out of
// real use, see assertPropertyAccess in src/lib/scope.ts) | ACTIVE (Osta-approved,
// fully usable — also the default, so every property that predates this feature is
// unaffected) | REJECTED (Osta declined; tenant can edit and resubmit, which flips it
// back to PENDING). No SUSPENDED state yet — deferred until actually needed.
model Property {
  id               String     @id @default(uuid())
  enterpriseId     String
  enterprise       Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  name             String
  code             String     @unique
  legalName        String
  defaultCurrency  String
  timeZone         String
  checkInTime      String
  checkOutTime     String
  status           String     @default("ACTIVE")
  // Set only when status transitions to ACTIVE or REJECTED via the Osta approval
  // queue (src/app/api/osta/properties/[id]/approve|reject) — null while PENDING.
  reviewedByUserId String?
  reviewedBy       User?      @relation("PropertyReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  // Only meaningful when status is REJECTED — cleared on resubmit.
  rejectionReason  String?
  logoUrl          String?
  taxId            String?
  contactPhone     String?
  contactEmail     String?
  // Street/location line shown on every printed stationary header (Invoices, Receipts,
  // Confirmation Letters, Registration Cards, Statements). Per-property, since branding
  // identity is sourced from the property's own General profile — not enterprise-wide.
  address          String?
  latitude         Float?
  longitude        Float?
  starRating       Int?

  // The property's own accent — a thin line shown at the top of every page while this
  // property is the active one (see src/components/ui/property-banner-bar.tsx). Null
  // means no custom accent (monochromatic default). A raw hex, not a preset name, so a
  // future free-form color picker doesn't need a schema change. Distinct per property,
  // never shared across an enterprise's other properties.
  //
  // Doubles as the accent colour of every printed stationary for this property (invoice
  // header rules, table borders, totals) — chosen in Controls > General > Appearance,
  // alongside stationeryFont below. Null falls back to the default brand colour at render
  // time (see resolveInvoiceBrandColor).
  bannerColor String?

  // Typeface for every printed stationary for this property — set in Controls > General >
  // Appearance so all documents inherit one font. Maps to a Tailwind font class via
  // resolveStationeryFontClass (Geist/Inter/Roboto → sans, Georgia → serif, Courier → mono).
  // Null falls back to "Geist".
  stationeryFont String? @default("Geist")

  // Per-property arrival gate (app-owner decision 2026-07-21): when on, a guest can
  // only be checked into a room whose housekeeping status is INSPECTED — the
  // supervisor-inspection workflow. Off (default) keeps the existing behavior
  // (DIRTY warns, only OOO/OOS block).
  requireInspectionOnCheckIn Boolean @default(false)

  // Optional End-of-Day housekeeping auto-shift (app-owner request 2026-07-26). When
  // enabled, Night Audit downgrades room housekeeping statuses as the business date
  // rolls. OCCUPIED rooms always become DIRTY (daily service); the mode below governs
  // only VACANT sellable rooms. Out-of-Order / Out-of-Service rooms are never touched.
  //   OFF        — no auto-shift (default; current behavior).
  //   STEP_DOWN  — move one status down: Inspected→Clean, Clean→Dirty, Dirty stays.
  //   SET_STATUS — set every vacant room to eodHousekeepingTargetStatus.
  eodHousekeepingMode         String  @default("OFF")
  // Target status for SET_STATUS mode — one of CLEAN | DIRTY | INSPECTED. Null/ignored
  // for OFF and STEP_DOWN.
  eodHousekeepingTargetStatus String?

  // "Top level" inclusive/exclusive tax setting — applies to anything charged at this
  // property unless a future transaction-level override says otherwise (not built yet).
  // True: rates are tax-inclusive, so Green Tax/GST/Service Charge are reverse-calculated
  // out of the posted amount. False: taxes are added on top. Deliberately per-property,
  // not enterprise-wide — see src/components/controls/tax-manager.tsx.
  pricesIncludeTaxes Boolean @default(true)

  // "Allocation Calculation" (Controls > Revenue) — which side drives automatic
  // Allocation attachment on a reservation. "RATE_PLAN": only the assigned Rate
  // Plan's own linked Allocations attach; the reservation's Meal Plan field becomes
  // a cosmetic label with no attachment effect. "MEAL_PLAN": only the selected Meal
  // Plan's linked Allocations attach; a Rate Plan's own linked Allocations are
  // ignored. Exclusive — never both at once (see src/lib/allocations.ts
  // resolveLinkedAllocationIds). Per-property, and changing it is NOT retroactive —
  // only reservations created/edited afterward are affected (see DECISIONS.md).
  allocationCalculationMode String @default("RATE_PLAN")

  // The property's current BUSINESS DATE — the operational "today" that drives
  // check-in/out gating, arrivals/departures, and the date every Night Audit
  // posting is stamped with. Distinct from EnterpriseSettings.systemDate (the
  // real server/wall-clock date); the business date only moves forward when
  // Night Audit (End-of-Day) is run for this property. Nullable so pre-existing
  // rows read through a server-date fallback until their first audit
  // (see src/lib/business-date.ts). A future Auto-EOD will roll this off systemDate.
  businessDate DateTime?

  // Force-logout watermark for End-of-Day: set to "now" when EOD finalizes.
  // requireSession() (src/lib/scope.ts) rejects any PROPERTY-scoped user of this
  // property whose token was issued before it — forcing a re-login so property staff
  // can't keep posting while the business date rolls. Enterprise-scoped users are
  // unaffected. Null = no forced logout pending.
  eodSessionsInvalidAt DateTime?

  eodRuns            EodRun[]
  guestRegistrations GuestRegistration[]
  eodReports         EodReport[]
  cashierShifts      CashierShift[]

  buildings                    Building[]
  facilities                   Facility[]
  roomTypes                    RoomType[]
  rooms                        Room[]
  ratePlans                    RatePlan[]
  channelLink                  ChannelPropertyLink?
  licenseAllowance             PropertyLicenseAllowance?
  inboundBookings              ChannelInboundBooking[]
  mealPlans                    MealPlan[]
  reservations                 Reservation[]
  groupBlocks                  GroupBlock[]
  nightAudits                  PropertyNightAuditLog[]
  workLocationUsers            User[]                        @relation("UserWorkLocation")
  sequences                    PropertySequence[]
  outlets                      Outlet[]
  outletChecks                 OutletCheck[]
  folios                       Folio[]
  currencyExchanges            CurrencyExchange[]
  allocations                  Allocation[]
  feeRules                     PropertyFeeRule[]
  // Stop-Sale / availability restrictions (see AvailabilityRestriction) — a row's
  // presence closes that date for sale, property-wide or per room type.
  availabilityRestrictions     AvailabilityRestriction[]
  // Profiles whose Profile.originPropertyId points here — a "first seen at" breadcrumb
  // only; does not restrict the profile to this property (Profile stays enterprise-wide).
  originatingProfiles          Profile[]
  // The Excursions catalog/bookings sold through the enterprise-level add-on gate
  // (see EnterpriseAddonAccess), if purchased.
  excursionTypes               ExcursionType[]
  excursionBookings            ExcursionBooking[]
  // Spa Booking add-on (see SPA_PLAN.md) — same add-on shape as Excursions above,
  // gated through the same enterprise-level EnterpriseAddonAccess.
  spaTreatmentCategories       SpaTreatmentCategory[]
  spaTreatments                SpaTreatment[]
  spaTherapists                SpaTherapist[]
  spaRooms                     SpaRoom[]
  spaAppointments              SpaAppointment[]
  spaSettings                  SpaSettings?
  spaGuestTherapistPreferences SpaGuestTherapistPreference[]
  eRegistrationLinks           ERegistrationLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enterpriseId])
  @@index([reviewedByUserId])
}

model Building {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String

  floors Floor[]

  @@index([propertyId])
}

model Floor {
  id         String   @id @default(uuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name       String

  rooms Room[]

  @@index([buildingId])
}

model Facility {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name        String
  description String?

  @@index([propertyId])
}

model RoomType {
  id            String   @id @default(uuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name          String
  code          String
  maxOccupancy  Int
  // Adults included before an extra-adult surcharge applies at Night Audit — e.g. 2
  // for standard double occupancy. Editable per room type since a Family Suite's base
  // occupancy differs from a Standard Room's. Children always incur PriceCalendar's
  // extraChildPrice (no separate "included children" threshold — kept simple to match
  // how Green Tax already treats children as a flat per-child charge with no baseline
  // exemption).
  baseOccupancy Int      @default(2)
  description   String?

  // Deactivating a room type blocks any *new* reservation from being assigned to it and
  // cascades every one of its Room rows to status OUT_OF_SERVICE — but never deletes
  // anything, so existing reservation and folio history stays intact. Re-activating does
  // NOT auto-restore room status, since some rooms may have been OUT_OF_SERVICE for an
  // unrelated reason beforehand.
  isActive Boolean @default(true)

  channelMap ChannelRoomTypeMap?
  inboundBookings ChannelInboundBooking[]

  // Pseudo room types represent a dummy/virtual category (e.g. day-use, overbooking
  // buffer). Rooms created under one skip Building/Floor assignment entirely (see
  // Room.floorId) since they have no physical location — distinct from a real,
  // sellable, physically-cleaned room type.
  isPseudo            Boolean @default(false)
  // Controls whether Housekeeping/Maintenance features (task assignment, status
  // workflows) are offered at all for rooms of this type. Off by default makes no
  // sense for real rooms, so this defaults to true; a pseudo room type is the main
  // case where an admin would turn it off.
  housekeepingEnabled Boolean @default(true)

  rooms             Room[]
  calendars         PriceCalendar[]
  RoomAssignment    RoomAssignment[]  @relation("AssignmentPhysicalRoomType")
  // Assignments physically in another room type but billed AS this type (kept rate on a room move).
  chargeAssignments RoomAssignment[]  @relation("AssignmentChargeRoomType")
  blockHolds        GroupBlockRoom[]
  // Per-room-type Stop-Sale rows (roomTypeId set) — property-level closures have a null
  // roomTypeId and don't appear here.
  availabilityRestrictions AvailabilityRestriction[]
  // Room-specific features — Bed Type, View, and Amenities are all multi-select, drawn
  // from the enterprise's own SystemCode LOV (categories BED_TYPE / ROOM_VIEW /
  // ROOM_AMENITY). A single generalized join table instead of one column per category,
  // since all three are "pick any number of codes from a category" in the same shape.
  features          RoomTypeFeature[]

  @@index([propertyId])
}

model RoomTypeFeature {
  id         String   @id @default(uuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  category   String // BED_TYPE | ROOM_VIEW | ROOM_AMENITY — matches SystemCode.category
  code       String

  @@unique([roomTypeId, category, code])
}

// Meal plans (Room Only / Bed & Breakfast / Half Board / ...) as first-class, property-
// configurable entities (Controls > Revenue) instead of a free string duplicated on
// both RatePlan and Reservation. `code` is what Reservation.mealPlan actually stores.
// Pricing for a given meal plan is NOT modeled here — the app owner's chosen
// mechanism is a Derived Rate Plan per meal plan variant (e.g. "BAR-BB" derived from
// "BAR" — see RatePlan.parentRatePlanId), so this model is purely the LOV: what meal
// plan codes exist and their display name, used to populate the Reservation form's
// selector and as an informational tag (kitchen/back-office visibility), not a
// pricing input to Night Audit.
model MealPlan {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code       String
  name       String
  isActive   Boolean  @default(true)

  // Which Allocations selecting this meal plan brings onto a reservation (BB → {BF},
  // HB → {BF, DN}) — this is what makes a meal plan actually price per-person, versus
  // the older Derived-Rate-Plan approach which can only shift the room rate.
  allocationLinks MealPlanAllocation[]

  @@unique([propertyId, code])
}

// RoomStatus: CLEAN, DIRTY, INSPECTED, OUT_OF_ORDER, OUT_OF_SERVICE
model Room {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  // Nullable — a room created under a Pseudo room type has no physical location, so it
  // skips Building/Floor assignment entirely (enforced in src/app/api/rooms/route.ts,
  // not here, since "which room types are pseudo" is a runtime lookup).
  floorId    String?
  floor      Floor?   @relation(fields: [floorId], references: [id])

  roomNumber String
  status     String @default("CLEAN")

  // Only meaningful while status is OUT_OF_ORDER (app-owner decision 2026-07-21:
  // fields on Room, no separate dated history model). Cleared when the room
  // returns to service. expectedReturn is informational — nothing auto-flips the
  // room back on that date; a human (or a maintenance-ticket resolution) does.
  oooReason         String?
  oooExpectedReturn DateTime?

  assignedAttendantId String?
  assignedAttendant   User?   @relation("RoomAssignedAttendant", fields: [assignedAttendantId], references: [id])

  maintenance       RoomMaintenance[]
  RoomAssignment    RoomAssignment[]
  housekeepingTasks HousekeepingTask[]
  // Additive on top of whatever the assigned RoomType.features already grants — e.g. a
  // specific room within a Deluxe Ocean View type that also happens to have a Balcony
  // not shared by every Deluxe Ocean View room.
  features          RoomFeature[]

  @@unique([propertyId, roomNumber])

  @@index([assignedAttendantId])
  @@index([floorId])
  @@index([roomTypeId])
}

model RoomFeature {
  id       String @id @default(uuid())
  roomId   String
  room     Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  category String // BED_TYPE | ROOM_VIEW | ROOM_AMENITY — matches SystemCode.category
  code     String

  @@unique([roomId, category, code])
}

model TaxProfile {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  name         String
  description  String?

  rates       TaxRate[]
  chargeCodes ChargeCode[]
  outlets     Outlet[]

  @@index([enterpriseId])
}

model TaxRate {
  id            String     @id @default(uuid())
  taxProfileId  String
  taxProfile    TaxProfile @relation(fields: [taxProfileId], references: [id], onDelete: Cascade)
  // A TaxProfile can hold several lines (e.g. "State Tax" + "Local Fee") applied
  // together on one charge — see src/lib/tax-calc.ts for the calculation engine this
  // feeds.
  name          String     @default("Tax")
  ratePercent   Float
  // BASE: a flat percentage of the charge's original subtotal, independent of every
  // other line (how Service Charge works today). COMPOUND: a percentage of the running
  // total so far — subtotal plus every line before it in `order` (how GST is
  // calculated on Base + Service Charge today). Lines are applied in ascending `order`.
  calculateOn   String     @default("BASE")
  order         Int        @default(0)
  effectiveFrom DateTime
  effectiveTo   DateTime?

  @@index([taxProfileId])
}

// Level 1 of the Opera-modelled Group → Subgroup → Code hierarchy. `reportBucket` is
// THE canonical reporting classification — every revenue/EOD/analytics report reads it
// (via ChargeCode.chargeSubgroup.chargeGroup) instead of the old free-text
// ChargeCode.category string. See src/lib/posting/charge-tree.ts for the canonical set
// seeded at onboarding.
model ChargeGroup {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  code         String // ACCOMMODATION | FOOD_BEVERAGE | TRANSPORT | OTHER | TAX | NON_REVENUE | SYSTEM
  name         String
  // ROOM | FOOD_BEVERAGE | TRANSPORT | OTHER | TAX | NON_REVENUE | SYSTEM — the one
  // closed list. Several groups may share a bucket; a bucket never spans meanings.
  reportBucket String
  // false for NON_REVENUE (commissions, deposits) and pass-through TAX buckets — these
  // must never be counted as earned revenue.
  isRevenue    Boolean    @default(true)
  // System-managed: cannot be deleted or have its code/bucket changed from the UI.
  isSystem     Boolean    @default(false)
  sortOrder    Int        @default(0)

  subgroups ChargeSubgroup[]

  @@unique([enterpriseId, code])
}

// Level 2 — the reporting sub-classification inside a group (e.g. 10RV Room Revenue
// under ACC; one nnRV subgroup per outlet under FNB/SPA/EXC).
model ChargeSubgroup {
  id            String      @id @default(uuid())
  enterpriseId  String
  enterprise    Enterprise  @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  chargeGroupId String
  chargeGroup   ChargeGroup @relation(fields: [chargeGroupId], references: [id], onDelete: Cascade)
  code          String
  name          String
  isSystem      Boolean     @default(false)
  sortOrder     Int         @default(0)
  // Outlet-wise subgroups (owner ruling 2026-07-30): an F&B/Spa/Excursion outlet owns
  // its own nnRV subgroup, provisioned with the outlet from its group's numeric band —
  // see src/lib/posting/outlet-subgroup.ts. Null = a general (non-outlet) subgroup.
  // SetNull so deleting an outlet keeps the subgroup and its posted history intact.
  outletId String?
  outlet   Outlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)

  chargeCodes ChargeCode[]

  @@unique([enterpriseId, code])

  @@index([chargeGroupId])
  @@index([outletId])
}

model ChargeCode {
  id            String      @id @default(uuid())
  enterpriseId  String
  enterprise    Enterprise  @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  code          String
  description   String
  // Level 3 of the hierarchy — and the ONLY classification: the deprecated free-text
  // `category` column it replaced was dropped once every reader was migrated
  // (CHARGE_CODE_PLAN.md phase 4). REQUIRED — every code is properly linked
  // group -> subgroup -> code, so nothing can post with no classification behind it.
  // Read the reporting bucket through chargeSubgroup.chargeGroup.reportBucket.
  chargeSubgroupId String
  chargeSubgroup   ChargeSubgroup @relation(fields: [chargeSubgroupId], references: [id])
  // Posting semantics that used to be implied by the magic code string:
  // CHARGE (ordinary revenue) | TAX (a levy — excluded from the GST base, e.g. GTX) |
  // CREDIT (posts negative, e.g. TA commission) | NON_REVENUE (never earned revenue).
  postingType   String      @default("CHARGE")
  // System-provisioned (accommodation, green tax, commission...): cannot be deleted.
  isSystem      Boolean     @default(false)
  isActive      Boolean     @default(true)
  // Whether this charge code applies the enterprise's own Maldives Tax config (Green
  // Tax/GST/Service Charge — see EnterpriseSettings) or a specific Custom Tax profile.
  // taxProfileId is only ever set when useDefaultTax is false.
  useDefaultTax Boolean     @default(true)
  taxProfileId  String?
  taxProfile    TaxProfile? @relation(fields: [taxProfileId], references: [id])

  // Opera's "generates" mechanism — posting this code automatically posts the derived
  // codes on the other side of these rows (see ChargeCodeGenerate).
  generatesFrom ChargeCodeGenerate[] @relation("GeneratorCode")
  generatedBy   ChargeCodeGenerate[] @relation("GeneratedCode")

  folioLineItems FolioLineItem[]
  // Money-IN postings. Every financial posting is linked to a charge code, a payment
  // just as much as a charge (owner rule, 2026-07-27): `paymentMethods` are the methods
  // that settle against this code, `payments` the settlements already made.
  paymentMethods PaymentMethod[]
  payments       Payment[]
  // The "shared pool" an Outlet curates from — a charge code is never owned by one
  // outlet, it can be exposed by any number of them (or none). See OutletChargeCode.
  outletCharges  OutletChargeCode[]
  allocations    Allocation[]
  // Rate plans that post their nightly room charge against this code (see
  // RatePlan.chargeCodeId). SetNull on delete, so removing a charge code just drops
  // those plans back to the enterprise default accommodation code, never cascade-
  // deletes a rate plan.
  ratePlans      RatePlan[]
  routingRules   FolioRoutingRule[]
  feeRules       PropertyFeeRule[]
  excursionTypes ExcursionType[]
  spaTreatments  SpaTreatment[]

  @@unique([enterpriseId, code])

  @@index([chargeSubgroupId])
  @@index([taxProfileId])
}

// Declarative replacement for hardcoded "posting ROOM also posts GTX" logic: posting the
// generator code automatically posts each generated code, in ascending sortOrder, through
// the same tax engine. See src/lib/posting/run-generates.ts.
model ChargeCodeGenerate {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  generatorCodeId String
  generatorCode   ChargeCode @relation("GeneratorCode", fields: [generatorCodeId], references: [id], onDelete: Cascade)
  generatedCodeId String
  generatedCode   ChargeCode @relation("GeneratedCode", fields: [generatedCodeId], references: [id], onDelete: Cascade)

  // PERCENT (of the basis) | FLAT (per posting) | PER_PERSON_PER_NIGHT (the Green-Tax
  // shape — value × persons × nights, supplied by the caller's postingContext).
  method String
  value  Float
  // What a PERCENT applies to: NET (the parent's pre-tax base), GROSS (base + tax +
  // service charge), or ANOTHER_GENERATE (basisGenerateId's own output — cascading).
  calculateOn     String  @default("NET")
  basisGenerateId String?
  sortOrder       Int     @default(0)
  isActive        Boolean @default(true)

  @@unique([generatorCodeId, generatedCodeId])
  @@index([enterpriseId, generatorCodeId])

  @@index([generatedCodeId])
}

// PaymentType: CASH, CARD, TRANSFER
model PaymentMethod {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  name         String
  type         String // Replaces PaymentType
  isActive     Boolean    @default(true)

  // EVERY financial posting is linked to a charge code — a payment just as much as a
  // charge to the guest (owner rule, 2026-07-27). This supersedes the earlier
  // "payment types are Payment Methods, not charge codes" decision: a method still
  // decides HOW money is taken, and now also which code that movement posts against,
  // so cash, card, transfer and city-ledger settlement are each identifiable in the
  // ledger. Nullable only so a method can be created before its code is chosen; the
  // API requires one before the method can be used.
  chargeCodeId String?
  chargeCode   ChargeCode? @relation(fields: [chargeCodeId], references: [id])

  payments Payment[]

  @@index([chargeCodeId])
  @@index([enterpriseId])
}

// ProfileType: GUEST, COMPANY, TRAVEL_AGENT, STAFF (GUEST/STAFF are "individual
// person" profiles — full Personal Information + Identification; COMPANY/TRAVEL_AGENT
// are "entity" profiles — single Name field, no Identification. STAFF is a directory
// record only, deliberately with no relation to User, the separate login/RBAC model.)
// ProfileClassification: VIP, REGULAR, BLACKLISTED
model Profile {
  upid              String     @id @default(uuid())
  enterpriseId      String
  enterprise        Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  profileType       String     @default("GUEST")
  title             String?
  firstName         String
  middleName        String?
  lastName          String?
  companyName       String?
  classification    String     @default("REGULAR")
  photoUrl          String?
  dateOfBirth       DateTime?
  // Distinct from ProfileAddress.country / ProfileDocument.issuingCountry — a single
  // Profile-level fact (SystemCode category NATIONALITY), not per-row.
  nationality       String?
  anniversaryDate   DateTime?
  // Replaces the old free-text loyaltyTier — SystemCode category VIP_LEVEL,
  // configurable via Controls > Dropdowns Manager.
  vipLevel          String?
  preferredLanguage String     @default("en")
  iataNumber        String?
  commissionRate    Float?
  greenTaxExempt    Boolean    @default(false)
  gender            String?
  membershipNumber  String?
  marketingOptIn    Boolean    @default(false)
  isIncognito       Boolean    @default(false)
  arNumber          String?    @unique
  creditLimit       Float?
  // Formally activates arNumber/creditLimit as a live Accounts Receivable account —
  // see the Debtors module (src/app/e/[slug]/dashboard/debtors/). Only meaningful for
  // COMPANY/TRAVEL_AGENT profiles, but not enforced at the DB level (profileType is a
  // free string, not an enum).
  isCreditAccount   Boolean    @default(false)
  // Enterprise/chain-wide stay totals (Profile has no propertyId — these accumulate
  // across every property). "Visits to Property" (singular, current property) is
  // NOT stored here — it's computed live from Reservation at read time, since a
  // per-property count can't live on an enterprise-scoped model. See stay-history route.
  totalStays        Int        @default(0)
  totalNights       Int        @default(0)
  totalRevenue      Float      @default(0.0)
  lastStayDate      DateTime?

  // Set once at creation from the active property context, never changed afterward —
  // a lightweight "first seen at" breadcrumb, not a scoping mechanism. The profile
  // remains fully usable/shared across every property in the enterprise regardless.
  originPropertyId String?
  originProperty   Property? @relation(fields: [originPropertyId], references: [id], onDelete: SetNull)

  communications           ProfileCommunication[]
  addresses                ProfileAddress[]
  attachments              ProfileAttachment[]
  preferences              ProfilePreference[]
  notes                    ProfileNote[]
  documents                ProfileDocument[]
  reservations             Reservation[]
  travelAgentReservations  Reservation[]                 @relation("TravelAgent")
  accompanyingReservations AccompanyingGuest[]
  foliosAsPayee            Folio[]                       @relation("PayeeProfile")
  groupBlocksAsPayee       GroupBlock[]                  @relation("GroupBlockPayee")
  guestRegistrations       GuestRegistration[]
  // Negotiated Rate Plans linked to this profile — only meaningful for COMPANY/
  // TRAVEL_AGENT profiles (see RatePlanAgentAccess).
  negotiatedRateAccess     RatePlanAgentAccess[]
  spaTherapistPreferences  SpaGuestTherapistPreference[]
  eRegistrationSlots       ERegistrationGuestSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enterpriseId])
  @@index([originPropertyId])
}

// Multiple per profile, one may be marked primary — type is a fixed 3-value enum
// (not an admin-configurable LOV; only VIP Level and Preferences were asked to be).
model ProfileCommunication {
  id        String   @id @default(uuid())
  upid      String
  profile   Profile  @relation(fields: [upid], references: [upid], onDelete: Cascade)
  type      String // EMAIL | MOBILE | SOCIAL
  value     String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([upid])
}

// Multiple per profile, one may be marked primary. fullAddress is one free-text block
// (not street-line-broken) per the app owner's spec; city/state/zip/country are
// separate structured fields alongside it.
model ProfileAddress {
  id            String   @id @default(uuid())
  upid          String
  profile       Profile  @relation(fields: [upid], references: [upid], onDelete: Cascade)
  type          String // HOME | BUSINESS | BILLING
  fullAddress   String
  city          String?
  stateProvince String?
  postalCode    String?
  country       String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([upid])
}

// A clickable reference list (label + externally-hosted URL) — deliberately not a
// file-upload/storage system, which doesn't exist anywhere else in this app either
// (owner-confirmed: URL-referenced list, not real upload).
model ProfileAttachment {
  id        String   @id @default(uuid())
  upid      String
  profile   Profile  @relation(fields: [upid], references: [upid], onDelete: Cascade)
  label     String
  url       String
  createdAt DateTime @default(now())

  @@index([upid])
}

model ProfilePreference {
  id       String  @id @default(uuid())
  upid     String
  profile  Profile @relation(fields: [upid], references: [upid], onDelete: Cascade)
  category String // DIETARY | PREFERENCE | ROOM | BEDDING | AMENITY
  value    String
  notes    String?

  @@index([upid])
}

model ProfileDocument {
  id               String    @id @default(uuid())
  upid             String
  profile          Profile   @relation(fields: [upid], references: [upid], onDelete: Cascade)
  documentType     String // PASSPORT, NATIONAL_ID
  documentNumber   String
  issuingCountry   String?
  issueDate        DateTime?
  expiryDate       DateTime?
  documentImageUrl String?
  // Relative path under the private, gitignored upload storage directory (see
  // src/lib/eregistration/storage.ts) — distinct from documentImageUrl above, which
  // stays a plain external-URL field. Set when an eRegistration submission's ID photo
  // is applied here; the same file is never copied, just pointed at from both places.
  documentImageStoragePath String?
  isPrimary        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([upid, documentType, documentNumber])
}

model ProfileNote {
  id           String   @id @default(uuid())
  upid         String
  profile      Profile  @relation(fields: [upid], references: [upid], onDelete: Cascade)
  authorUserId String
  noteText     String
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([upid])
}

model RatePlan {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  channelMap      ChannelRatePlanMap?
  code            String
  name            String
  description     String?
  priority        Int      @default(0)
  isNegotiated    Boolean  @default(false)
  // Classification flags for zero/nominal-rate stays — comp'd rooms (VIPs, media,
  // familiarization trips) and internal staff/owner use. Pure labels for now, same
  // starting point isNegotiated had before its Negotiated Rates follow-up; no posting
  // or reporting behavior is tied to them yet.
  isComplimentary Boolean  @default(false)
  isHouseUse      Boolean  @default(false)

  // The charge code this plan's nightly room charge posts against at Night Audit —
  // usually the property's main Accommodation code. Null means "use the enterprise
  // default accommodation code" (EnterpriseSettings.defaultAccommodationChargeCodeId,
  // then the legacy "ROOM" code as a last resort). onDelete SetNull so removing a
  // charge code just drops the plan back to the default, never deletes the plan.
  chargeCodeId String?
  chargeCode   ChargeCode? @relation(fields: [chargeCodeId], references: [id], onDelete: SetNull)

  // Marks the property's system-provisioned "Base Rate" (code "BASE", auto-created at
  // property onboarding — see src/app/api/properties/route.ts) — exactly one per
  // property, cannot be deleted, and its own identity fields (code/name/priority/
  // negotiated/derive-from) cannot be edited via the API (src/app/api/rate-plans/
  // [id]/route.ts silently ignores those on a locked plan). Its PriceCalendar and
  // Package Allocations links remain fully editable like any other plan. Night Audit
  // falls back to this plan's PriceCalendar entry (see night-audit/run/route.ts) when
  // the reservation's own assigned rate plan has no entry for that date — this is the
  // "default rate for all room types/rate plans when nothing custom is specified,"
  // replacing the old flat, always-on RoomType.basePrice fallback.
  isLocked Boolean @default(false)

  // Derived Rate Plans: a plan can inherit its per-night price from another plan at
  // the same property, plus a percent or flat adjustment (e.g. "BAR-BB" derived from
  // "BAR" at +$20 flat, or a promo code derived at -10%). Resolved live at every
  // lookup (Night Audit, Price Calendar display) — never materialized into this
  // plan's own PriceCalendar rows, so it always tracks the parent's current pricing
  // with no sync step. Chaining is disallowed (a derived plan's parent must not
  // itself be derived) — enforced in the API, not the DB, to keep resolution a single
  // hop. onDelete: SetNull rather than Cascade so deleting a parent doesn't cascade-
  // delete every plan derived from it — it just orphans them back to independent.
  parentRatePlanId       String?
  parentRatePlan         RatePlan?  @relation("DerivedRatePlans", fields: [parentRatePlanId], references: [id], onDelete: SetNull)
  derivedRatePlans       RatePlan[] @relation("DerivedRatePlans")
  // "PERCENT" | "FLAT" — null when this plan is not derived from another.
  derivedAdjustmentType  String?
  // For PERCENT: e.g. 10 means parent price + 10%, -10 means parent price - 10%.
  // For FLAT: e.g. 20 means parent price + $20, -20 means parent price - $20.
  derivedAdjustmentValue Float?

  calendars       PriceCalendar[]
  RoomAssignment  RoomAssignment[]
  channelBookingDefaults ChannelBookingDefaults[]
  // Which Allocations this plan carries as a package (see Allocation.mode for whether
  // each is carved out of or added on top of the room rate). A derived plan with no
  // links of its own inherits its parent's — see src/lib/allocations.ts.
  allocationLinks RatePlanAllocation[]
  // Only meaningful when isNegotiated is true — restricts this plan to the linked
  // Company/Travel Agent profiles' bookings (see RatePlanAgentAccess). Empty means
  // "negotiated but not yet restricted to anyone," which the reservation form treats
  // as unselectable until at least one profile is linked, same as any other negotiated
  // plan with a non-matching travel agent.
  agentAccess     RatePlanAgentAccess[]

  @@unique([propertyId, code])

  @@index([chargeCodeId])
  @@index([parentRatePlanId])
}

model PriceCalendar {
  id              String   @id @default(uuid())
  ratePlanId      String
  ratePlan        RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  roomTypeId      String
  roomType        RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date            DateTime
  price           Float
  // Optional per-night surcharge for occupants beyond RoomType.baseOccupancy (adults)
  // or any child (children) on this date — null means no surcharge; there is no
  // further fallback for these (unlike `price`, which falls back to the property's
  // locked Base rate plan's own PriceCalendar entry — see RatePlan.isLocked).
  extraAdultPrice Float?
  extraChildPrice Float?

  @@unique([ratePlanId, roomTypeId, date])

  @@index([roomTypeId])
}

// Stop-Sale / availability restriction. A row's PRESENCE means the date is CLOSED (not
// open to sell); its absence means OPEN — the default — so OPEN is never stored and
// "set to Open" simply deletes the row. Open/Closed is the only restriction type today
// (no CTA/CTD/min-stay yet). Enforced as a HARD block on new reservations (see
// src/lib/restrictions.ts + api/reservations), and surfaced on the Availability grid.
//
// roomTypeId null = a PROPERTY-WIDE closure that date (blocks every room type). A row
// with roomTypeId set closes only that one type. Dates are UTC midnights, matching the
// PriceCalendar/Reservation convention. Note: SQLite treats NULLs as distinct in the
// unique index, so the @@unique below does not by itself prevent duplicate
// property-level rows for a date — the API create-if-absent / delete-all-matching flow
// keeps them idempotent (a duplicate "closed" row is harmless; delete removes them all).
model AvailabilityRestriction {
  id              String    @id @default(uuid())
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId      String?
  roomType        RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date            DateTime
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([propertyId, roomTypeId, date])
  @@index([propertyId, date])

  @@index([roomTypeId])
}

// ReservationStatus: RESERVED, IN_HOUSE, CHECKED_OUT, NO_SHOW, CANCELLED
model Reservation {
  id             String   @id @default(uuid())
  confirmationNo String   @unique
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id])
  primaryGuestId String
  primaryGuest   Profile  @relation(fields: [primaryGuestId], references: [upid])

  travelAgentId String?
  travelAgent   Profile? @relation("TravelAgent", fields: [travelAgentId], references: [upid])

  groupBlockId String?
  groupBlock   GroupBlock? @relation(fields: [groupBlockId], references: [id])
  // Group pickups default to billing the block's master folio; staff can flip this
  // off per pickup so the guest settles their own folio. Only meaningful when
  // groupBlockId is set and the block has an open master folio (Night Audit routing).
  groupBillToMaster Boolean @default(true)

  checkInDate           DateTime
  checkOutDate          DateTime
  // Actual arrival timestamp, set when the guest is checked in (status → IN_HOUSE).
  // Used to order guest Registration No assignment at EOD (check-in date then time).
  checkedInAt           DateTime?
  // Actual departure timestamp, set at check-out (status → CHECKED_OUT) and cleared when
  // a check-out is reversed. Its calendar date is treated as the checkout's business day,
  // which gates the same-day-only reversal of any City-Ledger (debtor) invoice finalized
  // at checkout — see api/reservations/[id]/reverse-check-out/route.ts.
  checkedOutAt          DateTime?
  // Optional per-reservation fee-rule selections (PropertyFeeRule ids, one per type). The
  // chosen rule drives the fee computed at its event: DEPOSIT (suggested pre-arrival
  // amount), CANCELLATION (posted on cancel), NO_SHOW (posted at Night Audit). Null = no
  // rule of that type applies = no fee. Plain id references (not FK relations) — a deleted
  // or disabled rule is simply treated as "no fee" at apply time.
  depositFeeRuleId      String?
  cancellationFeeRuleId String?
  noShowFeeRuleId       String?
  // The last stay-night (date) already billed upfront by an Advance Bill. Night Audit
  // skips room/allocation/green-tax posting for any night on or before this date — those
  // nights were posted (dated the settlement day) when the Advance Bill was generated, so
  // re-posting them would double-charge. Null = nothing advance-billed. See
  // api/reservations/[id]/advance-bill/route.ts.
  advanceBilledThrough  DateTime?
  adults                Int       @default(1)
  children              Int       @default(0)
  // Under the enterprise's Green Tax exemption age (EnterpriseSettings.greenTaxExemptAge)
  // — tracked as its own occupancy bucket rather than inferred from `children`, since
  // Reservation carries only headcounts, not individual guest birthdates. Infants are
  // exempt from Green Tax and are not counted toward room occupancy.
  infants               Int       @default(0)
  mealPlan              String    @default("NONE")
  status                String    @default("RESERVED")
  // Set when the reservation is cancelled (status → CANCELLED): the moment and the
  // operator-supplied reason. Drives the Cancellations & No-Shows report so it can
  // be filtered by "cancelled on date X" rather than a proxy timestamp.
  cancelledAt           DateTime?
  cancellationReason    String?
  // Set when the reservation is marked a no-show (status → NO_SHOW), by Night Audit
  // for un-arrived bookings or manually. The business date the no-show was recorded.
  noShowAt              DateTime?
  // Free-text front-desk note surfaced on the guest Confirmation Letter (e.g. "Honeymoon
  // — high floor requested") — deliberately a single field on the reservation itself,
  // not sourced from ReservationTrace (that's an operational task/message log, not
  // curated guest-facing text).
  remarks               String?
  // Derived at create/edit time (see src/lib/reservation-assignments.ts) whenever two
  // date-adjacent segments assign different physical rooms — i.e. the stay itself
  // requires a mid-stay room change on a known future date, distinct from the ad-hoc
  // RoomAssignment/room-move flow (RESERVATIONS/route.ts room-move) which only ever
  // acts "as of today". Surfaced as a badge on the reservation and via the Front
  // Office "Room Moves Due Today" worklist (front-office/summary route).
  hasScheduledRoomMove  Boolean   @default(false)

  assignments                  RoomAssignment[]
  folios                       Folio[]
  traces                       ReservationTrace[]
  accompanyingGuests           AccompanyingGuest[]
  // Materialized allocation attachments (source: RATE_PLAN | MEAL_PLAN | MANUAL) —
  // written at create/edit, read by Night Audit. See ReservationAllocation.
  allocations                  ReservationAllocation[]
  specialRequests              ReservationSpecialRequest[]
  routingRules                 FolioRoutingRule[]
  guestRegistrations           GuestRegistration[]
  excursionBookings            ExcursionBooking[]
  channelInboundBookings       ChannelInboundBooking[]
  transports                   ReservationTransport[]
  // A reservation can be the guest identity behind a Spa appointment participant —
  // see SpaAppointmentParticipant.reservationId (not SpaAppointment directly, since
  // guest identity is per-participant under the multi-resource design).
  spaAppointmentParticipations SpaAppointmentParticipant[]
  eRegistrationLinks           ERegistrationLink[]
  eRegistrationSlots           ERegistrationGuestSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupBlockId])
  @@index([primaryGuestId])
  @@index([propertyId])
  @@index([travelAgentId])
}

// Pickup/Dropoff transport for a reservation — one row per direction (arrival pickup,
// departure dropoff). transportType is a SystemCode `TRANSPORT_TYPE` code (Speedboat,
// Taxi, …), configurable in Controls. When the hotel books it, `chargeAmount` +
// `chargeToGuest` drive a one-off charge posted to the guest folio via a TRANSPORTATION
// charge code; `chargedLineItemId` is stamped once posted so it can't be double-charged.
model ReservationTransport {
  id                String      @id @default(cuid())
  reservationId     String
  reservation       Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  direction         String // PICKUP | DROPOFF
  transportType     String? // SystemCode TRANSPORT_TYPE code (Speedboat / Taxi / …)
  carrierCode       String? // Carrier Code (flight no.)
  carrierTime       DateTime? // Carrier Time (flight time)
  transportNo       String? // Transport No.
  transportTime     DateTime? // Transport Time
  remarks           String? // Transport Remarks
  // When the hotel books it: chargeCodeId (selectable) + chargeAmount are posted to the
  // guest folio; chargedLineItemId is stamped once posted so it can't be double-charged.
  chargeToGuest     Boolean     @default(false)
  chargeCodeId      String?
  chargeAmount      Float?
  chargedLineItemId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reservationId, direction])
}

// Tag-style special requests picked at booking time from the SPECIAL_REQUEST SystemCode
// LOV (Controls > Reservations > Reservation Dropdown Lists). `code` stores the
// SystemCode code string — same convention as Profile.vipLevel/classification — so
// renaming a request's display value in Controls never touches existing reservations.
model ReservationSpecialRequest {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  code          String
  createdAt     DateTime    @default(now())

  @@unique([reservationId, code])
}

model Folio {
  id                 String       @id @default(uuid())
  // Nullable — a walk-in/passerby folio (an outlet sale with no room booking) has no
  // Reservation to attach to. Reservation-backed folios keep working exactly as before;
  // routes must derive scoping from `propertyId` directly, not `reservation.propertyId`,
  // since that path is now only ever present for the reservation-backed case.
  reservationId      String?
  reservation        Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  propertyId         String
  property           Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  folioNumber        Int          @default(1)
  isClosed           Boolean      @default(false)
  // The property business date on which this folio was closed. A closed walk-in (Fast
  // Post) bill can only be REOPENED while the business date still equals this — once Night
  // Audit rolls the day, the bill is final. Set when isClosed flips true, cleared on reopen.
  closedBusinessDate DateTime?
  isMaster           Boolean      @default(false)

  // DIRECT (guest pays, default) | CITY_LEDGER (billed to a TA/corporate credit
  // account — enables the "Bill to Account" action in the Folio Panel). Defaults to
  // CITY_LEDGER at reservation creation when a credit-account Travel Agent/corporate
  // profile is attached; not re-evaluated on edit so a staff override isn't clobbered.
  settlementMethod String @default("DIRECT")

  // True only once this reservation's own folio has been finalized into a debtor
  // invoice (see the Debtors module) — flips at checkout, and only for a folio still
  // set to CITY_LEDGER at that moment with a valid isCreditAccount travel agent
  // attached (src/app/api/reservations/[id]/check-out/route.ts). Before checkout
  // it's always false, which is what keeps in-house reservations out of the Debtors
  // module entirely. One invoice = one reservation's folio, not a shared ledger.
  isDebtorAccount Boolean @default(false)

  // Populated only when reservationId is null — who a walk-in folio's bill is for.
  walkInGuestName    String?
  walkInGuestContact String?

  payeeProfileId String?
  payeeProfile   Profile? @relation("PayeeProfile", fields: [payeeProfileId], references: [upid])

  groupBlockId String?
  groupBlock   GroupBlock? @relation(fields: [groupBlockId], references: [id])

  // Assigned once, the first time each document type is printed for this folio (via
  // the property's TAX_INVOICE / PROFORMA_FOLIO PropertySequence) — never
  // reallocated on reprint. Independent fields since a folio may be printed as
  // either or both over its lifetime.
  taxInvoiceNumber      String?
  proformaInvoiceNumber String?

  lineItems          FolioLineItem[]
  payments           Payment[]
  // Standing routing rules that redirect charges of a given code INTO this folio
  // (this folio is the target). See FolioRoutingRule.
  routingTargetRules FolioRoutingRule[] @relation("RoutingTargetFolio")
  excursionBookings  ExcursionBooking[]
  spaAppointments    SpaAppointment[]
  outletChecks       OutletCheck[]

  @@index([propertyId])

  @@index([groupBlockId])
  @@index([payeeProfileId])
  @@index([reservationId])
}

model FolioLineItem {
  id                  String          @id @default(uuid())
  folioId             String
  folio               Folio           @relation(fields: [folioId], references: [id], onDelete: Cascade)
  chargeCodeId        String
  chargeCode          ChargeCode      @relation(fields: [chargeCodeId], references: [id])
  // Which Outlet this charge was posted through, if any — null for ordinary front-desk/
  // room charges. Lets revenue be attributed per outlet without changing how tax or the
  // charge code itself works.
  outletId            String?
  outlet              Outlet?         @relation(fields: [outletId], references: [id])
  // The outlet sales check this line belongs to, if it was posted through an outlet.
  // Groups the line items sold in one Fast Post session (or one walk-in bill) under a
  // single human-readable check number (SPA-00001). Null for non-outlet charges.
  // SetNull on delete — losing the grouping never deletes billing history.
  outletCheckId       String?
  outletCheck         OutletCheck?    @relation(fields: [outletCheckId], references: [id], onDelete: SetNull)
  // Which RoomAssignment (segment) this line came from — set on the Nightly Room
  // Charge and Extra Occupancy Charge lines posted by Night Audit, null for every
  // other charge type. Lets checkout attribute room revenue back to the specific rate
  // plan that earned it for Travel Agent commission calculation (a split-stay
  // reservation can span more than one rate plan). onDelete SetNull — losing the
  // attribution on room reassignment doesn't need to delete billing history.
  roomAssignmentId    String?
  roomAssignment      RoomAssignment? @relation(fields: [roomAssignmentId], references: [id], onDelete: SetNull)
  // The cashier shift this charge was posted during, if a front-desk user posted it
  // while holding an open shift on the folio's property. Null for Night Audit and
  // other system postings. SetNull on delete — losing the attribution never deletes
  // billing history. Drives the per-shift "postings by charge code" summary.
  shiftId             String?
  shift               CashierShift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  date                DateTime
  // The line's own descriptive text — auto-filled from the charge code's
  // description at posting time, editable by the operator.
  description         String
  // Free-text reference printed in the invoice's Reference column (folio/PMS
  // ref, external doc number, "per agreement 2026-04", etc.). Distinct from
  // description; null falls back to the charge code on the printed document.
  reference           String?
  amount              Float
  taxAmount           Float           @default(0.0)
  serviceChargeAmount Float           @default(0.0)
  isVoid              Boolean         @default(false)
  // Set on a line that a ChargeCodeGenerate produced (Service Charge, GST, Green Tax,
  // any declared levy), pointing at the revenue line that generated it. Two things need
  // it: a tax line must report under the bucket of the revenue that earned it — a GST
  // line's own charge code sits in the TAX group, so without this every report would
  // show tax detached from its source — and it makes a parent's derived lines findable
  // as a set. SetNull rather than Cascade: losing the attribution must never silently
  // delete a posted tax line.
  generatedFromLineItemId String?
  generatedFrom           FolioLineItem?  @relation("GeneratedLines", fields: [generatedFromLineItemId], references: [id], onDelete: SetNull)
  generatedLines          FolioLineItem[] @relation("GeneratedLines")

  createdAt DateTime @default(now())

  // Back-reference from ExcursionBooking.folioLineItemId (1:1, optional).
  excursionBooking ExcursionBooking?
  // Back-reference from SpaAppointment.folioLineItemId (1:1, optional).
  spaAppointment   SpaAppointment?

  @@index([chargeCodeId])
  @@index([folioId])
  @@index([generatedFromLineItemId])
  @@index([outletCheckId])
  @@index([outletId])
  @@index([roomAssignmentId])
  @@index([shiftId])
}

// A standing "routing instruction": charges of a given ChargeCode on a source
// Reservation are automatically redirected INTO targetFolio when posted (by Night
// Audit or manual posting), instead of landing on the reservation's own primary
// folio. The target may be another folio window on the same reservation, or the
// folio of another in-house reservation ("bill this room's X charges to that
// room"). One rule per (reservation, chargeCode); creating a rule also moves any
// already-posted matching charges (apply-now). Cascade-deleted with the source
// reservation.
model FolioRoutingRule {
  id              String      @id @default(uuid())
  reservationId   String
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  chargeCodeId    String
  chargeCode      ChargeCode  @relation(fields: [chargeCodeId], references: [id])
  targetFolioId   String
  targetFolio     Folio       @relation("RoutingTargetFolio", fields: [targetFolioId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdAt       DateTime    @default(now())

  @@unique([reservationId, chargeCodeId])

  @@index([chargeCodeId])
  @@index([targetFolioId])
}

// A front-desk cashier's drawer session, scoped to (userId, propertyId): a user
// working two properties keeps a separate drawer per property. Auto-opened the
// first time the user touches a billing screen for a property (0 float), closed
// either manually at end of shift or force-closed by that property's Night Audit.
// businessDate is the property's operational date at open time — it anchors the
// shift to a business day so the EOD Cashier Summary can group by (property, date)
// even if wall-clock time drifts from the business date.
model CashierShift {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  userId       String
  // Nullable for pre-migration rows; every shift opened after this migration has one.
  propertyId   String?
  property     Property?  @relation(fields: [propertyId], references: [id])
  businessDate DateTime?
  openedAt     DateTime   @default(now())
  closedAt     DateTime?
  openingFloat Float      @default(0.0)
  closingDrop  Float?

  payments          Payment[]
  currencyExchanges CurrencyExchange[]
  paidOuts          CashierPaidOut[]
  // Charges posted by this cashier during the shift — set on manual/front-desk
  // postings so the shift can show "what I posted, by charge code". Night Audit and
  // other system postings leave shiftId null and never count toward a cashier's shift.
  lineItems         FolioLineItem[]
  // NOTE: a PARTIAL unique index `CashierShift_one_open_per_user_property` — UNIQUE
  // (userId, propertyId) WHERE closedAt IS NULL — is enforced at the DB level via
  // migration 20260725150000_cashier_shift_one_open. Prisma's schema can't express a
  // filtered index, so it is intentionally NOT declared here. Do not let `prisma migrate
  // dev` drop it — it's what stops a race from opening two drawers for one user+property.

  @@index([propertyId])
  @@index([userId])

  @@index([enterpriseId])
}

// A petty-cash disbursement from the drawer during a shift (florist COD, taxi
// reimbursement, stamp money) — reduces the shift's expected cash at blind-drop
// time. Deliberately not folio-linked: it's drawer bookkeeping, not guest billing.
model CashierPaidOut {
  id              String       @id @default(uuid())
  shiftId         String
  shift           CashierShift @relation(fields: [shiftId], references: [id])
  amount          Float
  reason          String
  createdByUserId String
  createdAt       DateTime     @default(now())

  @@index([shiftId])
}

model Payment {
  id              String        @id @default(uuid())
  folioId         String
  folio           Folio         @relation(fields: [folioId], references: [id])
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  shiftId         String
  shift           CashierShift  @relation(fields: [shiftId], references: [id])

  // Stamped from the payment method at posting time rather than read through the
  // method later, so a method being re-pointed never rewrites settled history — the
  // same reason a folio line carries its own charge code.
  chargeCodeId    String?
  chargeCode      ChargeCode? @relation(fields: [chargeCodeId], references: [id])

  amount          Float
  referenceNumber String?
  isRefund        Boolean @default(false)

  // What kind of money-in this is, for pre-arrival collections made through the
  // Deposit module: DEPOSIT | PRE_ARRIVAL_FEE | CANCELLATION_FEE | NO_SHOW_FEE.
  // Null for an ordinary in-stay folio payment. Purely a reporting/identification
  // tag — the amount behaves like any other payment on the folio.
  depositPurpose String?

  // Assigned once, the first time a receipt is printed for this payment (via the
  // property's RECEIPT_NO PropertySequence) — never reallocated on reprint. Null
  // means no receipt has been printed yet.
  receiptNumber String?

  createdAt DateTime @default(now())

  // Excursion bookings refunded by this payment (see ExcursionBooking.refundPaymentId)
  // — never automatic, always an explicit staff action.
  refundedExcursionBookings ExcursionBooking[]
  // Spa appointments refunded by this payment (see SpaAppointment.refundPaymentId) —
  // same "never automatic" convention.
  refundedSpaAppointments   SpaAppointment[]

  @@index([chargeCodeId])
  @@index([folioId])
  @@index([paymentMethodId])
  @@index([shiftId])
}

// Per-property fee rules (Controls > Fee Rules) that drive the Deposit module and
// the Cancellation / No-Show fee triggers. One row per (property, ruleType):
//   DEPOSIT      — the deposit to request pre-arrival (informational default).
//   CANCELLATION — the fee when a reservation is cancelled.
//   NO_SHOW      — the fee applied at Night Audit when a guest never arrives.
// The amount is computed from `basis`: FLAT ($value), PERCENT (value% of the
// projected stay total), FIRST_NIGHT (first night's room charge), or FULL_STAY
// (the whole projected stay). CANCELLATION/NO_SHOW post their fee against
// `chargeCode` so it reconciles on the folio against any held deposit.
// A named, per-property fee rule. There can be MANY rules per ruleType (e.g. several
// Cancellation policies); a reservation picks at most one rule of each type to apply, and
// the fee amount is computed from that rule's basis at the moment the event fires (cancel
// / no-show / deposit suggestion). `isActive` gates whether a rule is offered in the
// reservation picker. Selection is optional — a reservation with no rule of a type simply
// incurs no fee of that type. (Superseded the old one-rule-per-(property,ruleType) model,
// 2026-07-24 — see DECISIONS.md.)
model PropertyFeeRule {
  id           String      @id @default(uuid())
  propertyId   String
  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String      @default("")
  ruleType     String // DEPOSIT | CANCELLATION | NO_SHOW
  basis        String      @default("FLAT") // FLAT | PERCENT | FIRST_NIGHT | FULL_STAY
  value        Float       @default(0)
  chargeCodeId String?
  chargeCode   ChargeCode? @relation(fields: [chargeCodeId], references: [id])
  isActive     Boolean     @default(false)
  updatedAt    DateTime    @updatedAt

  @@index([propertyId, ruleType])

  @@index([chargeCodeId])
}

// A cashier-recorded currency exchange (guest-facing FX, common at resort front
// desks) — a real bookkeeping transaction, not just a printable form. Scoped to a
// Property (for branding/reporting) and tied to the cashier's CashierShift, mirroring
// how Payment is tied to a shift.
model CurrencyExchange {
  id         String       @id @default(uuid())
  propertyId String
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      CashierShift @relation(fields: [shiftId], references: [id])

  guestName    String?
  fromCurrency String
  toCurrency   String
  rate         Float
  amountFrom   Float
  amountTo     Float

  // Assigned once, the first time a receipt is printed (via the property's
  // RECEIPT_NO PropertySequence) — never reallocated on reprint.
  receiptNumber String?

  createdAt       DateTime @default(now())
  createdByUserId String
  createdBy       User     @relation("CurrencyExchangeCreatedBy", fields: [createdByUserId], references: [id])

  @@index([createdByUserId])
  @@index([propertyId])
  @@index([shiftId])
}

// A revenue-generating point of sale scoped to one Property (Spa, Restaurant, Bar,
// Gift Shop...). Deliberately does NOT own ChargeCodes — charge codes stay
// enterprise-wide and independent; an Outlet just curates which ones it exposes in its
// own POS view (see OutletChargeCode).
model Outlet {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Grouping only, same plain-string convention as ChargeCode.category (no Prisma enum
  // in this schema) — SPA | RESTAURANT | BAR | RETAIL | TRANSPORT | RECREATION | OTHER.
  outletType  String   @default("OTHER")
  isActive    Boolean  @default(true)

  // Business identity — an Outlet can raise walk-in bills "on its own behalf", so it
  // carries its own printed header (name above + these) and a tax registration number.
  // All nullable: legacy outlets predate these and are backfilled on next edit.
  code    String? // Short prefix for this outlet's sales-check numbers, e.g. "SPA" -> SPA-00001. Required by the API, nullable in the DB so existing rows don't break; unique per property (NULLs stay distinct).
  address String?
  email   String?
  phone   String?
  taxNo   String?

  // Per-outlet sales-check counter. Atomically incremented by allocateOutletCheckNumber
  // (src/lib/document-sequence.ts) when a check is opened; combined with `code` to form
  // the human-readable check number (SPA-00001). Never reset — numbers are never reused.
  checkSequence Int @default(0)

  // Top-level tax override, optional: NONE = no override, every charge code posted
  // through this outlet uses its own useDefaultTax/taxProfile exactly as everywhere
  // else. DEFAULT_ENGINE = force the enterprise default engine (Service Charge + GST)
  // regardless of the charge code's own setting. CUSTOM = force taxProfileId's rates
  // regardless of the charge code's own setting. taxProfileId is only ever set when
  // taxOverrideMode is CUSTOM. See src/lib/tax-calc.ts's resolveOutletChargeTax.
  taxOverrideMode String      @default("NONE")
  taxProfileId    String?
  taxProfile      TaxProfile? @relation(fields: [taxProfileId], references: [id])

  chargeCodes       OutletChargeCode[]
  folioLineItems    FolioLineItem[]
  checks            OutletCheck[]
  // The outlet's own nnRV charge subgroup(s) — see ChargeSubgroup.outletId.
  chargeSubgroups   ChargeSubgroup[]
  // Hub-wide module links (see EnterpriseSettings.spaOutlet / excursionOutlet) —
  // array-typed back-relations though each enterprise links at most one per module.
  spaModuleLinks       EnterpriseSettings[] @relation("EnterpriseSpaOutlet")
  excursionModuleLinks EnterpriseSettings[] @relation("EnterpriseExcursionOutlet")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, name])
  @@unique([propertyId, code])

  @@index([taxProfileId])
}

// The curated many-to-many "shared pool" — an explicit join model (not Prisma's
// implicit m:n) matching this schema's existing convention for join tables with their
// own identity (see AccompanyingGuest, RoomTypeFeature), and leaving room for a future
// per-outlet ordering/"featured" flag without a schema rewrite.
model OutletChargeCode {
  id           String     @id @default(uuid())
  outletId     String
  outlet       Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  chargeCodeId String
  chargeCode   ChargeCode @relation(fields: [chargeCodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([outletId, chargeCodeId])

  @@index([chargeCodeId])
}

// One outlet "sales check" — the identifiable grouping of charges sold through an Outlet
// in a single Fast Post session or a single walk-in bill. Its `checkNumber` (e.g.
// SPA-00001) is drawn once from the outlet's own counter (Outlet.checkSequence, via
// allocateOutletCheckNumber) so outlet sales are recognizable at a glance and never
// reuse a number. A walk-in bill maps 1:1 to a check (folioId set, and the bill prints
// the outlet's own header); room-posted charges reference the check number on the
// guest-house invoice without moving off it.
model OutletCheck {
  id          String   @id @default(uuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id])
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Set only for a walk-in bill's check (one check == one walk-in folio). Null while a
  // check groups charges posted onto in-house room folios.
  folioId     String?
  folio       Folio?   @relation(fields: [folioId], references: [id])
  checkNumber String
  isClosed    Boolean  @default(false)

  createdAt DateTime @default(now())

  lineItems FolioLineItem[]

  @@unique([outletId, checkNumber])
  @@index([folioId])
  @@index([propertyId])
}

model EnterpriseSettings {
  id           String     @id @default(uuid())
  enterpriseId String     @unique
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  resConfirmPrefix String @default("")
  resConfirmLength Int    @default(6)

  // Cashiering defaults (Controls > General) — previously hardcoded in the
  // cashiering page ($300 float, USD→MVR exchange). Defaults match those
  // hardcodes so existing enterprises see no behavior change.
  cashierDefaultFloat  Float  @default(300)
  exchangeFromCurrency String @default("USD")
  exchangeToCurrency   String @default("MVR")

  systemDate DateTime @default(now())

  // Posting & settlement defaults (see Controls > Finance). Plain nullable id pointers
  // (not FK relations) validated in the API — a dangling id is tolerated by falling
  // back at posting time. defaultAccommodationChargeCodeId: the ChargeCode a rate
  // plan's nightly room charge posts against when the plan itself doesn't specify one
  // (RatePlan.chargeCodeId). cityLedgerPaymentMethodId: the PaymentMethod (a
  // CITY_LEDGER-type method) used to record a settlement payment when a City Ledger
  // folio transfers to a debtor account at checkout.
  defaultAccommodationChargeCodeId String?
  // The ChargeCode the nightly Green Tax levy posts against, resolved by role instead of
  // the old literal `code: "GTX"` lookup (see resolveChargeCode in
  // src/lib/posting/resolve-charge-code.ts). Falls back to the system-seeded GTX code.
  defaultGreenTaxChargeCodeId      String?
  cityLedgerPaymentMethodId        String?
  // The (typically NON_REVENUE-categorized) ChargeCode a Travel Agent commission posts
  // against as a credit line at checkout — see RatePlanAgentAccess.commissionRate.
  // Null disables commission posting entirely, even if a rate plan has a rate set.
  commissionChargeCodeId           String?

  // DEPRECATED branding identity (name/logo/colour/font/tax/contact/address). Stationery
  // branding now comes from the property's own General profile + Appearance (Property.name,
  // logoUrl, taxId, contactPhone, contactEmail, address, bannerColor, stationeryFont) — see
  // resolveStationeryBrand() in src/lib/stationery-brand.ts. These columns are retained only
  // so existing rows aren't dropped; nothing reads them for rendering and the Stationaries
  // UI no longer writes them. Remove in a later cleanup migration once confirmed unused.
  invoiceBrandName    String?
  invoiceLogoUrl      String?
  invoiceBrandColor   String? @default("#4f46e5")
  invoiceFontFamily   String? @default("Geist")
  invoiceTaxId        String?
  invoicePhone        String?
  invoiceEmail        String?
  invoiceAddress      String?

  // Invoice document content (Proforma + Tax share everything but the header line).
  // The folio layout a Proforma / Tax Invoice / Interim Bill opens on — one of
  // src/lib/folio-presentation.ts's FOLIO_STYLES. The operator can still pick a
  // different one for an individual document; this is only what the picker defaults to.
  defaultFolioStyle   String  @default("detailed")

  // Hub-wide module outlet links (owner ruling 2026-07-30): Spa and Excursions each
  // post through ONE outlet shared across every property in the enterprise — a spa
  // appointment at property A may bill through an outlet homed at property B. While a
  // module's link is null, folio posting FROM that module is refused (bookings can
  // still be created); the pickers live first in Controls > Spa / Excursions.
  spaOutletId       String?
  spaOutlet         Outlet? @relation("EnterpriseSpaOutlet", fields: [spaOutletId], references: [id])
  excursionOutletId String?
  excursionOutlet   Outlet? @relation("EnterpriseExcursionOutlet", fields: [excursionOutletId], references: [id])
  invoiceHeaderText   String?
  invoiceFooterText   String?
  invoicePaymentTerms String?

  // Payment Information footer block shown on printed invoices (a raw hex account/bank
  // block, not a payment-gateway integration — the app never moves money itself). All
  // optional; the block is simply omitted where none are set.
  invoicePaymentAccountName   String?
  invoicePaymentAccountNumber String?
  invoicePaymentIban          String?
  invoicePaymentBankInfo      String?

  // Receipt document content (Payment + Currency Exchange receipts — the header label is
  // the only structural difference between them). Separate from the invoice footer/terms
  // so receipts can carry their own closing wording.
  receiptFooterText String?
  receiptTerms      String?

  // Account/Debtor Statement document content — its own footer/terms, separate from
  // invoices. (Full statement layout redesign pending the owner's template.)
  statementFooterText String?
  statementTerms      String?

  // Generic hotel-info/policy paragraph shown near the bottom of the guest
  // Confirmation Letter (see src/app/e/[slug]/dashboard/reservations/[id]/
  // confirmation-letter/page.tsx) — editable so each enterprise can state its own
  // check-in/out times and policies; falls back to sensible generic wording in code
  // when null.
  confirmationLetterMessage String?

  // Registration Card stationary (printed + signed by the guest at check-in — see
  // src/app/e/[slug]/dashboard/reservations/[id]/registration-card/page.tsx). Configured
  // in Controls > Stationaries. `registrationCardEnabled` gates the check-in wizard step;
  // the message is an optional welcome/intro line; the terms are the T&C block printed
  // above the signature line (falls back to generic wording in code when null).
  registrationCardEnabled Boolean @default(true)
  registrationCardMessage String?
  registrationCardTerms   String?

  // eRegistration (guest self check-in via a shareable temp link — see
  // src/app/eregistration/[token]/page.tsx and src/lib/eregistration/). The guest fills
  // in their own registration-card data; front desk still reviews/applies it and runs
  // the actual check-in unchanged. `eRegistrationExpiryHours` is the validity window
  // applied to every newly generated/regenerated link.
  eRegistrationEnabled      Boolean @default(true)
  eRegistrationExpiryHours  Int     @default(72)
  eRegistrationMessage      String?

  // Maldives Green Tax Settings — charged per person per night, split by age band;
  // below greenTaxExemptAge is fully exempt (MIRA: under 2 years).
  greenTaxEnabled     Boolean @default(true)
  greenTaxAdultAmount Float   @default(12.00)
  greenTaxChildAmount Float   @default(6.00)
  greenTaxExemptAge   Int     @default(2)

  // Maldives GST (formerly "TGST") and Service Charge Settings. Calculation order is
  // fixed: Service Charge is a percentage of the base amount, then GST is a percentage
  // of (base + Service Charge) — e.g. on a $100 base: SVC 10% = $10, GST 17% of $110 =
  // $18.70. Not yet wired into any actual charge-posting logic (Night Audit/Folios).
  tgstEnabled          Boolean @default(true)
  tgstRate             Float   @default(17.00)
  serviceChargeEnabled Boolean @default(true)
  serviceChargeRate    Float   @default(10.00)

  // SMTP/SFTP scaffold — fields only, not yet wired to any actual sending capability.
  // NOTE: stored as plain text; do not build real email/file-transfer sending on top of
  // this without first adding proper secret encryption at rest.
  smtpHost        String?
  smtpPort        Int?
  smtpUsername    String?
  smtpPassword    String?
  smtpFromAddress String?
  smtpUseTls      Boolean @default(true)

  sftpHost       String?
  sftpPort       Int?
  sftpUsername   String?
  sftpPassword   String?
  sftpRemotePath String?

  updatedAt DateTime @updatedAt

  @@index([excursionOutletId])
  @@index([spaOutletId])
}

// TraceType: GUEST_MESSAGE, WAKE_UP_CALL, MAINTENANCE, FRONT_DESK
model ReservationTrace {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  traceType   String
  description String
  actionDate  DateTime?
  isResolved  Boolean   @default(false)
  // When true, opening the reservation pops this trace's text every time until it's
  // marked resolved — for high-attention tasks the front desk must not miss.
  alertOnOpen Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId])
}

// IssueType: PLUMBING, ELECTRICAL, HVAC, GENERAL
// Priority: LOW, MEDIUM, HIGH
// Status: OPEN, IN_PROGRESS, RESOLVED
model RoomMaintenance {
  id     String @id @default(uuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  issueType   String @default("GENERAL")
  description String
  priority    String @default("MEDIUM")
  status      String @default("OPEN")

  reportedBy   String?
  assignedToId String?
  assignedTo   User?   @relation("MaintenanceAssignedTo", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([roomId])
}

model AccompanyingGuest {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  profileId     String
  profile       Profile     @relation(fields: [profileId], references: [upid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([reservationId, profileId])

  @@index([profileId])
}

// eRegistration — a shareable, unauthenticated temp link letting a guest fill in their
// own registration-card data before/at arrival. Scoped to exactly one of a single
// reservation OR a whole GroupBlock (the block's organizer fills slots across every
// current pickup) — app code enforces "exactly one is set", not a DB constraint.
//
// The raw token is never stored, only its SHA-256 hash (tokenHash) — a link is a bearer
// credential to submit/view guest PII, so a DB dump alone must never yield a usable
// guest-facing URL. The plaintext is returned once, in the generate response, and
// nowhere else afterward (see src/lib/eregistration/token.ts).
model ERegistrationLink {
  id            String       @id @default(uuid())
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  groupBlockId  String?
  groupBlock    GroupBlock?  @relation(fields: [groupBlockId], references: [id], onDelete: Cascade)
  // Denormalized, same reasoning as ExcursionBooking.propertyId — every eRegistration
  // route scopes directly off this row without a multi-hop join.
  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id])
  enterpriseId  String
  enterprise    Enterprise   @relation(fields: [enterpriseId], references: [id])

  tokenHash       String    @unique
  status          String    @default("ACTIVE") // ACTIVE | COMPLETED | EXPIRED | REVOKED
  expiresAt       DateTime
  createdByUserId String
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  revokedAt       DateTime?
  revokedByUserId String?
  lastAccessedAt  DateTime?

  slots ERegistrationGuestSlot[]

  @@index([reservationId])
  @@index([groupBlockId])

  @@index([enterpriseId])
  @@index([propertyId])
}

// One guest's own slot on a link. Always tagged with its OWN reservationId even under a
// group-scoped link (which fans out across several pickups) — review/apply never needs
// to join through the link to find which reservation a slot belongs to.
//
// The submitted fields are a permanent compliance snapshot: once finalized (status
// SUBMITTED) they are never silently overwritten — a guest re-submitting requires an
// explicit staff "reopen", and staff "apply" copies this snapshot into the live
// Profile/ProfileDocument records rather than the slot ever being edited to match them.
model ERegistrationGuestSlot {
  id                String            @id @default(uuid())
  linkId            String
  link              ERegistrationLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  reservationId     String
  reservation       Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  slotIndex         Int // 0 = that reservation's primary guest, 1..n = additional adults
  isPrimary         Boolean           @default(false)
  // Set when this slot maps to a Profile already on the reservation at generation time
  // (the primary guest, or an already-linked accompanying guest). Null = a new guest not
  // yet on the reservation — they type their own name.
  existingProfileId String?
  existingProfile   Profile?          @relation(fields: [existingProfileId], references: [upid])

  status String @default("PENDING") // PENDING | SUBMITTED | APPLIED

  firstName          String?
  middleName         String?
  lastName           String?
  dateOfBirth        DateTime?
  nationality        String?
  gender             String?
  email              String?
  mobile             String?
  addressFull        String?
  addressCity        String?
  addressCountry     String?
  documentType       String?
  documentNumber     String?
  issuingCountry     String?
  documentIssueDate  DateTime?
  documentExpiryDate DateTime?
  // Relative path under the private, gitignored upload directory — never a public URL.
  idPhotoPath        String?
  idPhotoMimeType    String?
  // PNG data URL of a live hand-drawn signature — required to finalize (government
  // compliance requirement: a live signature, not a typed name or checkbox).
  signatureDataUrl   String?

  submittedAt        DateTime?
  submittedIp        String?
  submittedUserAgent String?
  appliedAt          DateTime?
  appliedByUserId    String?

  // Declared minors traveling with THIS reservation's party (name + DOB only — no ID/
  // signature; minors don't sign a registration card). Only meaningful on the primary
  // (isPrimary) slot — kept per-reservation rather than per-link so it stays well-
  // defined under a group-scoped link, which can span several reservations at once.
  // Bounded JSON-in-text, same convention as ChannelBooking.rawPayload.
  childrenInfo String?

  @@unique([reservationId, slotIndex])

  @@index([existingProfileId])
  @@index([linkId])
}

model RoomAssignment {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  roomId           String?
  room             Room?     @relation(fields: [roomId], references: [id])
  roomTypeId       String
  roomType         RoomType  @relation("AssignmentPhysicalRoomType", fields: [roomTypeId], references: [id])
  // Optional "room type to charge": when a guest is moved to a physically different
  // room type but staff chose to KEEP the old rate, this pins the room type used for
  // pricing (PriceCalendar lookup + base occupancy) while `roomType` stays the real
  // room. Null = charge as the physical room type (the normal case). Ad-hoc room moves
  // only; scheduled multi-segment moves never set this.
  chargeRoomTypeId String?
  chargeRoomType   RoomType? @relation("AssignmentChargeRoomType", fields: [chargeRoomTypeId], references: [id])
  ratePlanId       String
  ratePlan         RatePlan  @relation(fields: [ratePlanId], references: [id])

  overrideRate Float?

  startDate DateTime
  endDate   DateTime

  folioLineItems FolioLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chargeRoomTypeId])
  @@index([ratePlanId])
  @@index([reservationId])
  @@index([roomId])
  @@index([roomTypeId])
}

// HousekeepingTaskStatus: PENDING, IN_PROGRESS, COMPLETED
model HousekeepingTask {
  id            String         @id @default(uuid())
  roomId        String
  room          Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  taskType      String         @default("FULL_SERVICE") // FULL_SERVICE, LIGHT_TOUCH, CHECKOUT
  status        String         @default("PENDING")
  assignedToId  String?
  assignedTo    RoomAttendant? @relation(fields: [assignedToId], references: [id])
  priority      String         @default("NORMAL") // LOW, NORMAL, HIGH
  notes         String?
  // Set the first time the task moves to IN_PROGRESS — with completedAt this gives
  // the attendant's time-on-task for the Housekeeping Attendant report.
  startedAt     DateTime?
  completedAt   DateTime?
  scheduledDate DateTime       @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([roomId])
}

model RoomAttendant {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone         String? // e.g. "Floor 1"

  tasks HousekeepingTask[]

  @@index([enterpriseId])
}

// GroupStatus: TENTATIVE, DEFINITE, CANCELLED
model GroupBlock {
  id             String    @id @default(uuid())
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id])
  // Group code is unique PER PROPERTY, not globally: a global unique let one tenant probe
  // another tenant's code namespace ("code already exists") and reserved codes across
  // unrelated properties. The create route checks existence via the compound key below.
  code           String
  name           String
  startDate      DateTime
  endDate        DateTime
  cutoffDate     DateTime?
  totalRoomsHeld Int       @default(0)
  status         String    @default("TENTATIVE")

  // Optional Travel Agent / Corporate credit account the block's master bill settles to
  // (City Ledger). When set, the master folio is created as CITY_LEDGER with this payee,
  // and CLOSING it finalizes a debtor invoice for the account — no per-reservation setup.
  payeeProfileId String?
  payeeProfile   Profile? @relation("GroupBlockPayee", fields: [payeeProfileId], references: [upid])

  reservations Reservation[]
  masterFolios Folio[]
  // Per-room-type rooms held for the block. totalRoomsHeld is kept in sync as the sum.
  roomHolds    GroupBlockRoom[]
  // A group-scoped eRegistration link: sent to the block's organizer (payeeProfile),
  // fanning out to every current pickup's own reservation-level slots.
  eRegistrationLinks ERegistrationLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, code])

  @@index([payeeProfileId])
}

// Rooms of a given type held by a group block for its whole date span. Outstanding
// holds (quantity minus already-picked-up rooms of that type) are subtracted from
// availability, so a block deducts from sellable inventory before pickups exist.
model GroupBlockRoom {
  id           String     @id @default(uuid())
  groupBlockId String
  groupBlock   GroupBlock @relation(fields: [groupBlockId], references: [id], onDelete: Cascade)
  roomTypeId   String
  roomType     RoomType   @relation(fields: [roomTypeId], references: [id])
  quantity     Int        @default(0)

  @@unique([groupBlockId, roomTypeId])

  @@index([roomTypeId])
}

model PropertyNightAuditLog {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  auditDate  DateTime
  executedAt DateTime @default(now())
  executedBy String?

  roomsOccupied Int
  roomRevenue   Float
  taxPosted     Float
  totalPostings Int

  // IN_PROGRESS | COMPLETED | FAILED. Exactly one row per (property, auditDate): the run
  // route claims it IN_PROGRESS before posting, flips it to COMPLETED inside the posting
  // transaction, or to FAILED on rollback (a FAILED row is reclaimable by a retry). The
  // unique key below is the real idempotency gate — it makes a concurrent/retried run
  // fail to claim rather than double-post. Mirrors EodRun's @@unique([propertyId, businessDate]).
  status String @default("COMPLETED")

  @@unique([propertyId, auditDate])
}

// A step-by-step End-of-Day run for one property's business date. The business date
// is OPEN until an EodRun for it reaches COMPLETED; a partially-run EOD leaves the
// date OPEN and is resumed from the first step whose timestamp is still null. One
// run per (property, businessDate). Steps, in order: departures resolved → cashiers
// closed → charges posted (delegates to the Night Audit run route, whose
// same-date idempotency is the double-post guard) → reports snapshotted → finalized
// (business date rolled + property sessions invalidated).
model EodRun {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  businessDate    DateTime
  status          String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  startedByUserId String
  startedAt       DateTime @default(now())

  // Per-step completion timestamps — null means "not done yet" (drives resume).
  departuresAt   DateTime?
  cashierAt      DateTime?
  postAt         DateTime?
  registrationAt DateTime?
  reportsAt      DateTime?
  finalizedAt    DateTime?
  completedAt    DateTime?

  @@unique([propertyId, businessDate])
}

// Tracks the current sequential counter for a numbered document type — Registration No,
// Proforma Folio, Tax Invoice, Receipt No. Deliberately doesn't manage prefixes/format
// (see EnterpriseSettings.resConfirmPrefix for that pattern elsewhere); this is just the
// plain integer count itself, per property. "Start from new sequence" in Controls sets
// currentValue directly — actually incrementing it on each new document issued is not
// wired up yet (belongs to whichever Phase 4/5 route actually creates these documents).
model PropertySequence {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sequenceType String // REGISTRATION_NO | PROFORMA_FOLIO | TAX_INVOICE | RECEIPT_NO | GUEST_REG_NO
  currentValue Int      @default(0)
  // For year-scoped sequences (GUEST_REG_NO, the Green Tax guest registration
  // number): the calendar year currentValue belongs to. On the first allocation of
  // a new year the counter resets to 0 (reset every 1st January). Null for plain
  // never-resetting sequences.
  resetYear    Int?
  updatedAt    DateTime @updatedAt

  @@unique([propertyId, sequenceType])
}

// The per-guest Registration Number assigned at End-of-Day to every guest who
// arrived on the business date (primary + accompanying), for the Green Tax return.
// Rooms of a pseudo room type (which covers day-use) are excluded. Numbered in
// arrival order (check-in date then time) and reset annually.
model GuestRegistration {
  id             String      @id @default(uuid())
  propertyId     String
  property       Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationId  String
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  profileId      String
  profile        Profile     @relation(fields: [profileId], references: [upid], onDelete: Cascade)
  registrationNo Int
  year           Int
  isPrimary      Boolean     @default(false)
  businessDate   DateTime
  createdAt      DateTime    @default(now())

  @@unique([propertyId, year, registrationNo])
  @@unique([reservationId, profileId])

  @@index([profileId])
}

// An immutable per-business-date report snapshot generated during EOD's reports
// step — the six regulatory/management reports, each stored as a JSON blob so a
// closed date's figures never change afterward. reportType is one of
// TRIAL_BALANCE | GUEST_LEDGER | AR_LEDGER | DEPOSIT_LEDGER | CASHIER_SUMMARY |
// MANAGER_FLASH.
model EodReport {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  businessDate DateTime
  reportType   String
  data         String
  generatedAt  DateTime @default(now())

  @@unique([propertyId, businessDate, reportType])
}

// Append-only user activity trail — one row per mutating action (views are
// deliberately never logged). Written exclusively through src/lib/activity-log.ts.
// Snapshot design, no FK relations: userEmail/userName are copied at write time so
// the trail survives user renames/deletions, and nothing can cascade-delete audit
// history. enterpriseId is null only for anonymous events (e.g. a failed login
// against an unknown email).
model UserActivityLog {
  id           String  @id @default(uuid())
  enterpriseId String?
  userId       String?
  userEmail    String?
  userName     String?
  // True when the action was performed by an Osta support user acting under an
  // approved SupportAccessGrant — support actions must be distinguishable in the
  // target enterprise's own trail.
  isSupport    Boolean @default(false)
  module       String // RBAC module name, or "AUTH" for login/logout events
  action       String // CREATE | UPDATE | DELETE | LOGIN | LOGIN_FAILED | LOGOUT | CHECK_IN | CHECK_OUT | VOID | RUN | ...
  entityType   String?
  entityId     String?
  description  String
  metadata     String? // JSON blob for structured detail (amounts, old→new values...)

  createdAt DateTime @default(now())

  @@index([enterpriseId, createdAt])
  @@index([userId, createdAt])
}

// ── Allocations (see .agents/docs/ALLOCATIONS_PLAN.md) ──────────────────────────────
// A per-person, date-range-priced component (Breakfast, Dinner, Speedboat Transfer,
// Spa, Excursion...) that attaches to Rate Plans (packages), Meal Plans, and
// Reservations, and posts to folios at Night Audit against its own ChargeCode.
// Property-scoped like RatePlan/MealPlan (offerings and prices differ per property);
// the ChargeCode it posts under stays enterprise-wide, same split as Outlets use.
model Allocation {
  id            String     @id @default(uuid())
  propertyId    String
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code          String // BF, LN, DN, TRF-SB, SPA-60...
  name          String // "Breakfast", "Speedboat Transfer"
  // Grouping for filtering/reporting only — FNB | TRANSFER | SPA | EXCURSION | OTHER.
  // Plain string, same convention as ChargeCode.category / Outlet.outletType.
  type          String     @default("OTHER")
  chargeCodeId  String
  chargeCode    ChargeCode @relation(fields: [chargeCodeId], references: [id])
  // When during the stay Night Audit posts this — EVERY_NIGHT | ARRIVAL_NIGHT |
  // DEPARTURE_NIGHT (departure = the stay's last night; no audit runs for a guest on
  // their checkout date itself).
  postingRhythm String     @default("EVERY_NIGHT")
  // How this allocation behaves *when it is part of a rate plan* — INCLUDE_IN_RATE |
  // ADD_TO_RATE (owner-confirmed, defined per allocation item/code, never per link):
  // INCLUDE_IN_RATE — its value is carved OUT of the room line at posting (room line
  //   reduced, folio total unchanged — pure revenue attribution to this allocation's
  //   charge code).
  // ADD_TO_RATE — posts on top of the room rate as its own line.
  mode          String     @default("ADD_TO_RATE")
  // Independent of `mode` (owner-confirmed): whether this allocation can *also* be
  // attached manually to a reservation on its own, whether or not it's part of any
  // rate/meal plan. Turning this on doesn't change how it posts when it IS in a rate —
  // it just additionally exposes it in the reservation Add-ons picker.
  sellSeparate  Boolean    @default(false)
  isActive      Boolean    @default(true)

  rates                  AllocationRate[]
  ratePlanLinks          RatePlanAllocation[]
  mealPlanLinks          MealPlanAllocation[]
  reservationAllocations ReservationAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, code])

  @@index([chargeCodeId])
}

// Date-range pricing rows — ranges must never overlap (validated in the API, like rate
// pricing; SQLite can't enforce range exclusion). Null effectiveTo = open-ended. The
// row covering a given audit date supplies that night's prices; no covering row means
// the allocation simply posts nothing that night. Adults/children only — infants are
// never charged (owner-confirmed, consistent with the Green Tax infant exemption).
model AllocationRate {
  id            String     @id @default(uuid())
  allocationId  String
  allocation    Allocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  adultPrice    Float      @default(0)
  childPrice    Float      @default(0)
  effectiveFrom DateTime
  effectiveTo   DateTime?

  @@index([allocationId])
}

// "This package rate includes these allocations." Explicit join model with its own id,
// matching OutletChargeCode's convention. Whether each allocation is carved out of or
// added on top of the rate is the allocation's own mode, not a per-link setting.
model RatePlanAllocation {
  id           String     @id @default(uuid())
  ratePlanId   String
  ratePlan     RatePlan   @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  allocationId String
  allocation   Allocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ratePlanId, allocationId])

  @@index([allocationId])
}

// Restricts a negotiated RatePlan (RatePlan.isNegotiated) to specific Company/Travel
// Agent profiles — the reservation form's rate-plan selector only offers a negotiated
// plan when the booking's Travel Agent/Booking Source (Reservation.travelAgentId) is
// one of the profiles linked here. Non-negotiated plans are never gated by this table.
// Managed from the Profile side (Negotiated Rates section on a Company/Travel Agent
// profile) — see /api/profiles/[upid]/negotiated-rates.
model RatePlanAgentAccess {
  id             String   @id @default(uuid())
  ratePlanId     String
  ratePlan       RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  upid           String
  profile        Profile  @relation(fields: [upid], references: [upid], onDelete: Cascade)
  // Optional per-rate-plan commission % owed to this agent — null means no commission
  // for this specific plan. Calculated at checkout (see reservations/[id]/check-out/
  // route.ts) once the folio actually settles to this agent's City Ledger account, and
  // posted as a credit against the enterprise's configured Commission charge code
  // (EnterpriseSettings.commissionChargeCodeId).
  commissionRate Float?

  createdAt DateTime @default(now())

  @@unique([ratePlanId, upid])

  @@index([upid])
}

// "Choosing this meal plan on a reservation brings these allocations" (BB → {BF}).
model MealPlanAllocation {
  id           String     @id @default(uuid())
  mealPlanId   String
  mealPlan     MealPlan   @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  allocationId String
  allocation   Allocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([mealPlanId, allocationId])

  @@index([allocationId])
}

// The materialized per-reservation attachment set — written at reservation create/edit
// (RATE_PLAN/MEAL_PLAN rows re-derived on relevant edits, MANUAL rows preserved), and
// the ONLY thing Night Audit reads. Editing a rate plan's links later never silently
// reprices an in-house stay. No onDelete cascade from Allocation: deleting an
// allocation that reservations reference is blocked by the FK, which is the safe
// default (deactivate instead).
model ReservationAllocation {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  allocationId  String
  allocation    Allocation  @relation(fields: [allocationId], references: [id])
  source        String // RATE_PLAN | MEAL_PLAN | MANUAL

  // Nullable per-reservation negotiated price overrides; null = use AllocationRate.
  overrideAdultPrice Float?
  overrideChildPrice Float?

  createdAt DateTime @default(now())

  @@unique([reservationId, allocationId])

  @@index([allocationId])
}

// ---------------------------------------------------------------------------
// Excursions Booking add-on — see .agents/docs/EXCURSIONS_PLAN.md for the full
// design and the rationale behind every decision below.
// ---------------------------------------------------------------------------

// Generic sellable add-on gate, ENTERPRISE-scoped (owner decision 2026-08-02: add-ons
// like Spa/Excursions are sold to the enterprise, and once enabled apply to every
// property in it — replaced the per-property PropertyModuleAccess table). EXCURSIONS
// was the first real consumer; the table stays generic so any future add-on reuses it
// without a new migration.
model EnterpriseAddonAccess {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  module       String
  // Defaults false (opt-in add-on). A missing row means "not purchased," which is
  // every enterprise's starting state.
  enabled      Boolean    @default(false)
  updatedAt    DateTime   @updatedAt

  @@unique([enterpriseId, module])
}

// Property-level Excursions settings — currently just the optional module-level Outlet
// link (mirrors SpaSettings). A missing row means "defaults / unlinked", every property's
// starting state, so the settings API upserts lazily. When outletId is set, excursion
// charges post through that outlet (revenue attribution + the outlet's Tax Rule via
// resolveOutletChargeTax); null keeps the current behavior (the excursion type's own
// charge code and tax).
// Property-scoped catalog entry for a bookable activity (Snorkelling Trip, Island
// Hopping, Night Fishing...) — same scoping convention as RatePlan/Allocation/Outlet:
// the offering differs per property, but the linked ChargeCode stays enterprise-wide.
model ExcursionType {
  id           String     @id @default(uuid())
  propertyId   String
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code         String // SNORK, ISLE, NFISH...
  name         String // "Snorkelling Trip"
  description  String?
  chargeCodeId String
  chargeCode   ChargeCode @relation(fields: [chargeCodeId], references: [id])
  // PER_PERSON: headcount x the active ExcursionRate. FLAT: ExcursionRate.flatPrice
  // regardless of headcount (e.g. a private charter).
  pricingMode  String     @default("PER_PERSON")
  // Hours before a departure's start time a booking can still be freely cancelled —
  // see ExcursionBooking below. Past this window, cancelling requires the "delete"
  // action on EXCURSIONS (manager override), not a hard block.
  cutoffHours  Int        @default(24)
  isActive     Boolean    @default(true)

  rates      ExcursionRate[]
  schedules  ExcursionSchedule[]
  departures ExcursionDeparture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, code])

  @@index([chargeCodeId])
}

// Dated pricing, same shape and non-overlapping-range rule as AllocationRate — the row
// covering the booking date wins. Unlike Allocations, infants get a real price tier
// here rather than always being free, per app-owner decision.
model ExcursionRate {
  id              String        @id @default(uuid())
  excursionTypeId String
  excursionType   ExcursionType @relation(fields: [excursionTypeId], references: [id], onDelete: Cascade)
  adultPrice      Float         @default(0)
  childPrice      Float         @default(0)
  infantPrice     Float         @default(0)
  // Only meaningful under pricingMode = FLAT; left null under PER_PERSON.
  flatPrice       Float?
  effectiveFrom   DateTime
  effectiveTo     DateTime? // null = open-ended; ranges must not overlap (API-validated)

  @@index([excursionTypeId])
}

// The recurring half of the "hybrid" scheduling model (see EXCURSIONS_PLAN.md) — a
// template that a Controls "generate departures" action expands into ExcursionDeparture
// rows. Editing a template never retroactively touches already-generated departures.
model ExcursionSchedule {
  id              String        @id @default(uuid())
  excursionTypeId String
  excursionType   ExcursionType @relation(fields: [excursionTypeId], references: [id], onDelete: Cascade)
  daysOfWeek      String // comma-separated day codes, e.g. "MON,WED,FRI"
  departureTime   String // "09:00" — when the trip actually leaves
  meetingTime     String? // "08:45" — when guests must be ready; distinct from departureTime
  meetingPoint    String? // "Main Jetty"
  capacity        Int
  // Soft "at risk of not running" flag only, mirrored onto each generated
  // ExcursionDeparture — never blocks or auto-cancels anything.
  minCapacity     Int?
  isActive        Boolean       @default(true)

  departures ExcursionDeparture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([excursionTypeId])
}

// One bookable instance — either generated from a schedule or added ad hoc (the manual
// half of "hybrid"). Capacity/meeting fields are copied from the schedule at
// generation time but are independently editable per instance afterward.
model ExcursionDeparture {
  id              String             @id @default(uuid())
  excursionTypeId String
  excursionType   ExcursionType      @relation(fields: [excursionTypeId], references: [id], onDelete: Cascade)
  // Null when hand-added rather than generated from a template. A regenerate run never
  // overwrites an existing departure for a date it already has one, generated or not.
  scheduleId      String?
  schedule        ExcursionSchedule? @relation(fields: [scheduleId], references: [id])

  departureDate DateTime // date only; time-of-day kept separate below
  departureTime String
  meetingTime   String?
  meetingPoint  String?
  capacity      Int
  minCapacity   Int?

  status String  @default("SCHEDULED") // SCHEDULED | CANCELLED | COMPLETED
  notes  String?

  bookings          ExcursionBooking[] @relation("DepartureBookings")
  // Bookings that exist because THIS departure was cancelled (e.g. weather) and the
  // guest was moved to a replacement — see ExcursionBooking.movedFromDepartureId.
  movedBookingsAway ExcursionBooking[] @relation("MovedFromDeparture")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([excursionTypeId, departureDate, departureTime])

  @@index([scheduleId])
}

// The actual sale. Guest identity is XOR (reservationId OR walk-in name/contact),
// validated in the API route not the DB — same convention as OutletAppointment.
// Billing always flows through the existing Folio/FolioLineItem/Payment machinery
// rather than a parallel payment path — see EXCURSIONS_PLAN.md "Billing".
model ExcursionBooking {
  id          String             @id @default(uuid())
  departureId String
  departure   ExcursionDeparture @relation("DepartureBookings", fields: [departureId], references: [id])
  // Denormalized from departure -> excursionType -> property so every route can scope
  // by propertyId directly (assertPropertyAccess) without a multi-hop join — same
  // reasoning as Folio.propertyId.
  propertyId  String
  property    Property           @relation(fields: [propertyId], references: [id])

  reservationId      String?
  reservation        Reservation? @relation(fields: [reservationId], references: [id])
  walkInGuestName    String?
  walkInGuestContact String?

  adultCount  Int   @default(1)
  childCount  Int   @default(0)
  infantCount Int   @default(0)
  // Snapshotted at booking time from the active ExcursionRate x headcount (or
  // flatPrice) — never recomputed later even if the rate changes afterward.
  totalAmount Float

  status String @default("CONFIRMED") // CONFIRMED | CANCELLED | COMPLETED | NO_SHOW

  // folioId is always set — either the guest's existing open room folio (in-house) or
  // a fresh walk-in folio created for this booking (walk-in). folioLineItemId is set
  // once the charge is actually posted.
  folioId         String
  folio           Folio          @relation(fields: [folioId], references: [id])
  folioLineItemId String?        @unique
  folioLineItem   FolioLineItem? @relation(fields: [folioLineItemId], references: [id])
  // Set only if cancelling this booking triggers an explicit refund Payment — never
  // automatic (matches how nothing else in this app auto-refunds either).
  refundPaymentId String?
  refundPayment   Payment?       @relation(fields: [refundPaymentId], references: [id])

  notes                String?
  bookedByUserId       String
  cancelledAt          DateTime?
  cancellationReason   String?
  // Set when this booking exists because its original departure was cancelled and the
  // guest was moved to a replacement — points at the ORIGINAL departure, not the
  // current one, so the manifest history stays honest about what actually happened.
  movedFromDepartureId String?
  movedFromDeparture   ExcursionDeparture? @relation("MovedFromDeparture", fields: [movedFromDepartureId], references: [id])
  // Set on the OLD (cancelled) booking once it has been moved to a replacement —
  // the reverse of movedFromDepartureId, plain id with no relation (same convention
  // as bookedByUserId). Without this, the same already-moved booking could be
  // "moved" again, creating a duplicate booking for the same guest.
  movedToBookingId     String?             @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departureId])

  @@index([folioId])
  @@index([movedFromDepartureId])
  @@index([propertyId])
  @@index([refundPaymentId])
  @@index([reservationId])
}

// ---------------------------------------------------------------------------
// Spa Booking add-on — see .agents/docs/SPA_PLAN.md for the full design and the
// rationale behind every decision below. Second consumer of the generic add-on gate
// Excursions introduced above (EnterpriseAddonAccess since 2026-08-02) — reused
// as-is, no schema changes to that model.
// ---------------------------------------------------------------------------

model SpaTreatmentCategory {
  id           String         @id @default(uuid())
  propertyId   String
  property     Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  displayOrder Int            @default(0)
  isActive     Boolean        @default(true)
  treatments   SpaTreatment[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([propertyId, name])
}

model SpaTreatment {
  id                       String               @id @default(uuid())
  propertyId               String
  property                 Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  categoryId               String
  category                 SpaTreatmentCategory @relation(fields: [categoryId], references: [id])
  name                     String
  shortName                String?
  description              String?
  defaultDurationMinutes   Int
  preparationBufferMinutes Int                  @default(0)
  cleanupBufferMinutes     Int                  @default(0)
  chargeCodeId             String
  chargeCode               ChargeCode           @relation(fields: [chargeCodeId], references: [id])
  // Every v1 treatment requires exactly one therapist per participant + one shared
  // room — the confirmed business rule. No requiresTherapist/requiresRoom flags:
  // they'd be unused branching for a hypothetical treatment type that doesn't exist
  // yet.
  // How many guests can share one SpaAppointment (SPA_PLAN.md §3 row 7, Option A) —
  // 1 = standard individual treatment (default), >1 = bookable as a couple/group
  // session, each participant getting their own therapist within one shared room +
  // time window.
  maxParticipants          Int                  @default(1)
  // PER_PERSON: rate.price x SpaAppointment.partySize. FLAT: rate.price regardless
  // of partySize (a genuine package price, e.g. "Couple Massage"). Same shape as
  // ExcursionType.pricingMode.
  pricingMode              String               @default("PER_PERSON")
  allowWalkIn              Boolean              @default(true)
  allowInHouseGuest        Boolean              @default(true)
  displayOrder             Int                  @default(0)
  isActive                 Boolean              @default(true)

  rates           SpaTreatmentRate[]
  therapistSkills SpaTherapistTreatment[]
  compatibleRooms SpaTreatmentRoom[]
  appointments    SpaAppointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([chargeCodeId])
  @@index([propertyId])
}

// Dated pricing — same shape and non-overlapping-range rule as ExcursionRate/
// AllocationRate. No per-rate currency field: the property's single default
// currency is implicit, matching every other rate model in this app.
model SpaTreatmentRate {
  id            String       @id @default(uuid())
  treatmentId   String
  treatment     SpaTreatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  price         Float
  effectiveFrom DateTime
  effectiveTo   DateTime? // null = open-ended; ranges validated non-overlapping in-app
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([treatmentId])
}

model SpaTherapist {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Links this therapist to a PMS login. When set, that user sees the appointments they're
  // booked on ("My Appointments") and can edit their own gender/phone/email. One user maps
  // to at most one therapist profile.
  userId       String?  @unique
  user         User?    @relation("SpaTherapistUser", fields: [userId], references: [id])
  displayName  String
  gender       String?
  phone        String?
  email        String?
  isActive     Boolean  @default(true)
  bookable     Boolean  @default(true)
  displayOrder Int      @default(0)

  skills                  SpaTherapistTreatment[]
  schedules               SpaTherapistSchedule[]
  exceptions              SpaTherapistAvailabilityException[]
  // A therapist is assigned per participant, not per appointment — see
  // SpaAppointmentParticipant.therapistId. No direct appointments[] relation here.
  // Split into resolved-assignment vs. explicit-request, mirroring the two fields on
  // SpaAppointmentParticipant itself.
  assignedParticipants    SpaAppointmentParticipant[]         @relation("AssignedTherapist")
  requestedByAppointments SpaAppointmentParticipant[]         @relation("RequestedTherapist")
  guestPreferences        SpaGuestTherapistPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

model SpaTherapistTreatment {
  id                    String       @id @default(uuid())
  therapistId           String
  therapist             SpaTherapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  treatmentId           String
  treatment             SpaTreatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  qualified             Boolean      @default(true)
  preferred             Boolean      @default(false)
  customDurationMinutes Int?
  notes                 String?

  @@unique([therapistId, treatmentId])

  @@index([treatmentId])
}

model SpaRoom {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  code         String?
  description  String?
  capacity     Int      @default(1) // must be >= the appointment's partySize to be a candidate room
  roomType     String? // free-text coarse filter, e.g. "MASSAGE" | "SALON" | "OUTDOOR"
  isActive     Boolean  @default(true)
  bookable     Boolean  @default(true)
  displayOrder Int      @default(0)

  compatibleTreatments SpaTreatmentRoom[]
  exceptions           SpaRoomAvailabilityException[]
  appointments         SpaAppointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

model SpaTreatmentRoom {
  id          String       @id @default(uuid())
  treatmentId String
  treatment   SpaTreatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  roomId      String
  room        SpaRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  preferred   Boolean      @default(false)

  @@unique([treatmentId, roomId])

  @@index([roomId])
}

model SpaTherapistSchedule {
  id            String       @id @default(uuid())
  therapistId   String
  therapist     SpaTherapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  dayOfWeek     Int // 0-6
  startTime     String // "HH:MM", same string convention as ExcursionSchedule.departureTime
  endTime       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean      @default(true)

  @@index([therapistId])
}

model SpaTherapistAvailabilityException {
  id            String       @id @default(uuid())
  therapistId   String
  therapist     SpaTherapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  date          DateTime
  startTime     String? // null + exceptionType UNAVAILABLE = whole day off
  endTime       String?
  exceptionType String // DAY_OFF | LEAVE | TRAINING | SICK | EXTENDED_HOURS | UNAVAILABLE
  reason        String?
  createdAt     DateTime     @default(now())

  @@index([therapistId])
}

model SpaRoomAvailabilityException {
  id            String   @id @default(uuid())
  roomId        String
  room          SpaRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date          DateTime
  startTime     String?
  endTime       String?
  exceptionType String // MAINTENANCE | CLEANING | RENOVATION | PRIVATE_EVENT | UNAVAILABLE
  reason        String?
  createdAt     DateTime @default(now())

  @@index([roomId])
}

model SpaSettings {
  propertyId String   @id
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // NOTE: the Spa Outlet link moved to EnterpriseSettings.spaOutletId (hub-wide,
  // owner ruling 2026-07-30) — this model keeps only per-property operational policy.

  defaultOpeningTime              String  @default("09:00")
  defaultClosingTime              String  @default("18:00")
  slotIntervalMinutes             Int     @default(15)
  defaultPreparationBufferMinutes Int     @default(0)
  defaultCleanupBufferMinutes     Int     @default(15)
  allowTentativeAppointments      Boolean @default(true)
  tentativeHoldMinutes            Int     @default(20)
  requireTherapistAtBooking       Boolean @default(true)
  requireRoomAtBooking            Boolean @default(true)
  allowAutoAssignment             Boolean @default(true)
  chargeTiming                    String  @default("AT_BOOKING") // AT_BOOKING | AT_COMPLETION
  cancellationCutoffHours         Int     @default(4)
  lateCancellationChargeType      String  @default("NONE") // NONE | FULL | PERCENTAGE | FIXED
  lateCancellationChargeValue     Float?
  noShowChargeType                String  @default("NONE")
  noShowChargeValue               Float?
  noShowGraceMinutes              Int     @default(15)
  requireCancellationReason       Boolean @default(true)
  requireRescheduleReason         Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// The parent booking record — one shared room, one shared time window, one folio
// charge. Multi-guest support (SPA_PLAN.md §3 row 7, Option A) lives one level down,
// in SpaAppointmentParticipant: each guest gets their own therapist, but there is
// exactly one SpaAppointment per booked session, not one per guest. No
// appointmentNumber field, matching ExcursionBooking exactly (identified by id).
model SpaAppointment {
  id                               String       @id @default(uuid())
  propertyId                       String // denormalized, same reasoning as ExcursionBooking.propertyId
  property                         Property     @relation(fields: [propertyId], references: [id])
  treatmentId                      String
  treatment                        SpaTreatment @relation(fields: [treatmentId], references: [id])
  treatmentNameSnapshot            String
  durationMinutesSnapshot          Int
  preparationBufferMinutesSnapshot Int
  cleanupBufferMinutesSnapshot     Int
  // Number of guests sharing this appointment, 1..treatment.maxParticipants at
  // booking time — must equal participants.length.
  partySize                        Int          @default(1)
  // Total price for the WHOLE appointment (all participants), computed and locked at
  // booking time, ALWAYS — regardless of chargeTiming. chargeTiming only controls
  // WHEN the FolioLineItem is created, never WHEN the price is determined. No
  // split-billing across participants in v1.
  priceSnapshot                    Float
  currencySnapshot                 String

  appointmentDate  DateTime // date-only component
  startTime        String // "HH:MM"
  treatmentEndTime String // startTime + durationMinutesSnapshot
  blockedUntilTime String // treatmentEndTime + cleanupBufferMinutesSnapshot — the real resource-hold end

  // The one shared room for the whole party (capacity must be >= partySize).
  // Nullable so a booking can be saved before room assignment when
  // SpaSettings.requireRoomAtBooking is false.
  roomId String?
  room   SpaRoom? @relation(fields: [roomId], references: [id])

  appointmentStatus String @default("TENTATIVE") // TENTATIVE|CONFIRMED|CHECKED_IN|IN_TREATMENT|COMPLETED|NO_SHOW|CANCELLED
  paymentStatus     String @default("NOT_POSTED") // NOT_POSTED|POSTED_TO_FOLIO|PARTIALLY_PAID|PAID|VOID_PENDING|VOIDED|REFUND_REQUIRED|REFUNDED
  source            String @default("FRONT_DESK")

  // Billing is single-folio — resolved from the participantIndex: 1 participant's
  // guest identity, regardless of partySize.
  folioId         String?
  folio           Folio?         @relation(fields: [folioId], references: [id])
  folioLineItemId String?        @unique
  folioLineItem   FolioLineItem? @relation(fields: [folioLineItemId], references: [id])
  refundPaymentId String?
  refundPayment   Payment?       @relation(fields: [refundPaymentId], references: [id])

  participants SpaAppointmentParticipant[]

  notes                  String?
  internalNotes          String? // operational notes only — no medical-record storage in v1
  cancellationReasonCode String?
  cancellationNotes      String?

  bookedByUserId     String
  cancelledByUserId  String?
  completedByUserId  String?
  checkedInAt        DateTime?
  treatmentStartedAt DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  noShowAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId, appointmentDate])
  @@index([roomId, appointmentDate])

  @@index([folioId])
  @@index([refundPaymentId])
  @@index([treatmentId])
}

// One row per guest within a SpaAppointment — where the actual "multi-resource"
// part of Option A lives: each participant is independently qualified, independently
// checked for availability, and independently assigned a therapist. participantIndex
// 1 is always the billing anchor (see SpaAppointment.folioId above); it has no other
// ordering meaning beyond "1 is primary."
model SpaAppointmentParticipant {
  id               String         @id @default(uuid())
  appointmentId    String
  appointment      SpaAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  participantIndex Int            @default(1)

  // XOR guest identity, validated in-route — same convention as
  // ExcursionBooking/OutletAppointment. guestType (IN_HOUSE|WALK_IN) is derived from
  // which of these is set, not stored separately.
  reservationId      String?
  reservation        Reservation? @relation(fields: [reservationId], references: [id])
  walkInGuestName    String?
  walkInGuestContact String?

  // Nullable so a booking can be saved before therapist assignment when
  // SpaSettings.requireTherapistAtBooking is false. This is the RESOLVED assignment
  // (auto-picked or the honored request below) — always the source of truth for who's
  // actually doing the treatment.
  therapistId String?
  therapist   SpaTherapist? @relation("AssignedTherapist", fields: [therapistId], references: [id])

  // What the guest actually ASKED for, kept separate from therapistId so booking never
  // conflates "auto-assigned" with "deliberately requested" — that distinction is what
  // lets a completed booking's therapistId feed back into
  // SpaGuestTherapistPreference ONLY when it reflects a genuine request, not every
  // auto-assigned visit. At most one of these two is set (mutually exclusive: a
  // specific-name request makes a gender filter moot).
  requestedTherapistId String?
  requestedTherapist   SpaTherapist? @relation("RequestedTherapist", fields: [requestedTherapistId], references: [id])
  requestedGender      String? // MALE | FEMALE — a hard filter, not a sort preference (see SPA_PLAN.md addendum)

  // Per-participant operational notes (pressure preference, etc.) — same restricted-
  // notes-only caveat as SpaAppointment.internalNotes.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([therapistId])
  @@index([appointmentId])

  @@index([requestedTherapistId])
  @@index([reservationId])
}

// A guest's remembered therapist at ONE property — deliberately not on the generic
// Profile model (ProfilePreference is free-text and untyped; this needs a real FK so
// it can be joined against SpaTherapist's qualification/active/bookable state, not just
// displayed). Scoped per-property since a guest visiting two resorts could reasonably
// prefer different people at each. Written automatically whenever a booking honors an
// explicit requestedTherapistId (see the appointments route) — no separate admin step.
model SpaGuestTherapistPreference {
  id          String       @id @default(uuid())
  profileId   String
  profile     Profile      @relation(fields: [profileId], references: [upid], onDelete: Cascade)
  propertyId  String
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  therapistId String
  therapist   SpaTherapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  updatedAt   DateTime     @updatedAt

  @@unique([profileId, propertyId])

  @@index([propertyId])
  @@index([therapistId])
}

// A connection to an external channel manager (Beds24 today) — the exchange interface
// between this enterprise and the booking channels. Lives at the ENTERPRISE level, which
// is why it is administered from the Hub and not the property dashboard. See
// .agents/docs/HUB_CHANNEL_MANAGER_PLAN.md.
//
// Deliberately NOT unique per enterprise. Beds24's own account model puts many properties
// under one account, but some operators keep a separate account per property — allowing
// several connections per enterprise supports both without a schema change, so the
// "one account per enterprise or per property?" question (plan decision D-6) never has to
// be answered up front. Which ostastay properties a connection covers is a separate
// mapping concern (ChannelPropertyLink), landing with the Sharing screen.
model ChannelConnection {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  // Only "BEDS24" today. A plain string rather than an enum to match the rest of this
  // schema (see Property.status, ChargeCode.category) and to keep adding a provider a
  // code-only change.
  provider     String     @default("BEDS24")
  // Operator-facing label, so several accounts stay tellable apart.
  name         String

  // The long-lived credential. ENCRYPTED AT REST via src/lib/secret-crypto.ts, exactly
  // like the SMTP/SFTP secrets in EnterpriseSettings — encrypt on write, decrypt only at
  // point of use, never returned to the client (the API redacts it with SECRET_MASK).
  //
  // Beds24 refresh tokens do not expire, BUT die if unused for 30 days — so a connection
  // that is simply idle will silently break. lastTokenRefreshAt is what makes that
  // visible before it happens; a keep-alive refresh must run well inside the window.
  refreshToken       String?
  lastTokenRefreshAt DateTime?

  // Cached short-lived access token (Beds24: ~24h), so a burst of API calls re-mints once
  // rather than per request. Also encrypted — it is a bearer credential in its own right.
  accessToken          String?
  accessTokenExpiresAt DateTime?

  // NOT_CONNECTED | CONNECTED | ERROR. Health is observed, never assumed: it is set from
  // real API outcomes (see src/lib/channels/beds24.ts), not from the fact that a
  // credential was saved.
  // Secret that authenticates this connection's inbound webhook URL. Deliberately a
  // per-connection URL secret rather than a payload signature: Beds24's signing scheme is
  // not documented publicly, and a URL secret works regardless of whether it has one.
  //
  // The raw token is never stored, only its SHA-256 hash — the URL is a WRITE-CAPABLE
  // bearer credential (holding it is authority to post bookings into this enterprise), so
  // a DB dump alone must never yield a working one. The plaintext is returned once, by
  // the generate endpoint, and nowhere else afterwards; if it is lost, regenerate and
  // re-paste it into the channel manager. See src/lib/channels/webhook-token.ts.
  webhookTokenHash  String?   @unique

  status            String    @default("NOT_CONNECTED")
  lastHealthCheckAt DateTime?
  // Operator-readable reason for the last failure; cleared on success.
  lastError         String?

  // Beds24's rate-limit state, as last observed from response headers (X-FiveMinCreditLimit,
  // -Remaining, -ResetsIn — confirmed present on every response by the official OpenAPI
  // spec). Captured passively on every real call rather than polled separately, so the
  // number shown is always whatever the most recent call actually saw.
  rateLimitTotal      Int?
  rateLimitRemaining  Int?
  rateLimitResetsAt   DateTime?
  rateLimitObservedAt DateTime?
  // Operator-configured safety margin: push/poll SKIP rather than call Beds24 once
  // rateLimitRemaining is at or below this and the reset window hasn't passed yet. Null
  // means no self-throttling — only Beds24's own limit applies, and a call is only ever
  // skipped once Beds24 itself would already be rejecting it.
  rateLimitPauseThreshold Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncLogs         ChannelSyncLog[]
  propertyLinks    ChannelPropertyLink[]
  inboundBookings  ChannelInboundBooking[]

  @@unique([enterpriseId, name])
}

// Which ostastay property a connection covers, and which channel-manager property it
// corresponds to. This is the "what do we share" control — see
// .agents/docs/HUB_CHANNEL_MANAGER_PLAN.md.
//
// ⚠️ propertyId is UNIQUE ACROSS ALL CONNECTIONS, not merely unique per connection. Linking
// one property through two channel-manager accounts would have both pushing availability for
// the same rooms and both accepting bookings against them — a double-sell that surfaces as
// an overbooked guest at the desk, not as an error anywhere in software. One property, one
// channel manager.
//
// A link references properties as CONFIGURATION, which is why this still belongs in the Hub:
// it is not an operation on a property, it is a statement about how that property is
// connected.
model ChannelPropertyLink {
  id           String            @id @default(uuid())
  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // The channel manager's own id for this property (Beds24 propertyId).
  externalPropertyId String

  // The master switch for this property's exchange. Deliberately defaults to FALSE: a newly
  // linked property must not start pushing inventory the moment it is created — mapping has
  // to be completed and reviewed first. Enabling is an explicit act.
  syncEnabled Boolean @default(false)

  roomTypeMaps ChannelRoomTypeMap[]
  ratePlanMaps ChannelRatePlanMap[]
  bookingDefaults ChannelBookingDefaults?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, externalPropertyId])
}

// ostastay RoomType ↔ channel-manager room. The mapping table is where most of the real
// integration work lives: everything downstream (availability push, inbound bookings) is
// meaningless without it.
model ChannelRoomTypeMap {
  id     String              @id @default(uuid())
  linkId String
  link   ChannelPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  roomTypeId String   @unique
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  externalRoomId String

  // Per-room-type share control: a property can be connected while deliberately holding
  // back individual room types (e.g. a suite sold only direct).
  shared Boolean @default(true)

  @@unique([linkId, externalRoomId])
}

// ostastay RatePlan ↔ channel-manager price/rate. Optional: a property can push availability
// with a single default rate before rate mapping is set up, so this does not gate readiness.
model ChannelRatePlanMap {
  id     String              @id @default(uuid())
  linkId String
  link   ChannelPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  ratePlanId String   @unique
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  externalRateId String

  @@unique([linkId, externalRateId])
}

// Every exchange with the channel manager, inbound and outbound — the troubleshooting
// record for the Hub's Logs screen. Deliberately built BEFORE the sync engine, so the
// very first sync is debuggable rather than a black box.
//
// ⚠️ THIS TABLE MUST NEVER CONTAIN A CREDENTIAL. The requests being logged carry invite
// codes, refresh tokens and access tokens in their headers; writing those here would
// defeat the encryption-at-rest on ChannelConnection entirely, since this table is
// plaintext and readable by anyone with Hub view access. Everything stored is passed
// through redactForLog() in src/lib/channels/redact.ts first — see the tests, which
// assert that a known secret never survives into a row.
model ChannelSyncLog {
  id String @id @default(uuid())
  // Denormalised so the Logs screen can scope and page without a join, and so entries
  // survive their connection being deleted (see connectionId below).
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  // SetNull, not Cascade: the logs explaining WHY a connection was removed are exactly
  // the ones worth keeping afterwards. connectionName is snapshotted for the same reason,
  // mirroring how UserActivityLog snapshots user identity.
  connectionId   String?
  connection     ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  connectionName String

  // OUTBOUND (we called the channel manager) | INBOUND (it called us, e.g. a webhook).
  direction String
  // Coarse operation name, e.g. "auth.setup", "auth.token", "connection.test".
  operation String
  endpoint  String?

  ok         Boolean
  httpStatus Int?
  latencyMs  Int?

  // Redacted, truncated summaries — enough to troubleshoot, never enough to leak.
  requestSummary  String?
  responseSummary String?
  errorMessage    String?

  createdAt DateTime @default(now())

  @@index([enterpriseId, createdAt])
  @@index([connectionId, createdAt])
}

// One execution of a background job for one enterprise — see src/lib/jobs/.
//
// Next.js has no scheduler of its own, so jobs are driven by an EXTERNAL cron hitting
// /api/jobs/run. That makes this table do double duty: it is both the audit trail (a
// silently-failing cron is worse than no cron, so every run is recorded whatever the
// outcome) and the mutual-exclusion lock.
//
// NOTE: a PARTIAL unique index `JobRun_one_running_per_job_enterprise` — UNIQUE
// ("jobName","enterpriseId") WHERE "status" = 'RUNNING' — is created in raw SQL by the
// migration, because Prisma cannot express a partial index. It is what makes overlapping
// cron invocations safe: the second one's INSERT fails rather than running the job twice.
// Same approach as CashierShift_one_open_per_user_property (audit finding A12).
//
// enterpriseId is deliberately NOT nullable: SQLite treats NULLs as distinct in a unique
// index, so a nullable column would silently permit concurrent "global" runs — exactly the
// case the lock exists to prevent. Every job today is per-enterprise anyway.
model JobRun {
  id           String     @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  jobName String
  // RUNNING | SUCCEEDED | FAILED. RUNNING doubles as the lock (see the partial index).
  status  String @default("RUNNING")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  itemsProcessed Int     @default(0)
  summary        String?
  // Redacted before storage — job errors can quote a channel-manager response back.
  error          String?

  @@index([jobName, startedAt])
  @@index([enterpriseId, startedAt])
}

// A booking received FROM the channel manager.
//
// Phase 1 of inbound (see .agents/docs/HUB_CHANNEL_MANAGER_PLAN.md): receive, normalise,
// detect problems and record — but do NOT create a Reservation yet. Reservation creation in
// this app is 408 lines inline in POST /api/reservations, wiring in allocations, special
// requests, availability and stop-sale conflicts, document sequences and activity logging.
// Reimplementing that here would miss something; converting these rows should go through a
// properly extracted service, which is the next slice.
//
// The RAW payload is always stored, even when parsing fails. The Beds24 booking shape is
// not verified against a live account, so the raw body is the only thing guaranteed to be
// correct — with it, a mis-parse is replayable rather than lost.
model ChannelInboundBooking {
  id           String            @id @default(uuid())
  enterpriseId String
  enterprise   Enterprise        @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // The channel manager's own booking id. THE idempotency key — webhook delivery is
  // at-least-once and the poller re-reads overlapping windows, so the same booking arrives
  // repeatedly and must be a no-op after the first time.
  externalBookingId String
  // Which OTA it originated from (Booking.com, Airbnb, ...), as reported by the channel.
  channelName       String?

  // WEBHOOK | POLL — how it reached us. Useful when diagnosing a missed webhook.
  source String

  // RECEIVED (not yet converted — includes one that failed a RETRIABLE check, such as no
  // default rate plan configured yet; the conversion sweep keeps retrying these) |
  // CONVERTED (see reservationId) | IGNORED (cancelled at the channel before conversion) |
  // FAILED (an unexpected error, not one of the ordinary validation failures — kept out of
  // the automatic retry sweep so a persistent unexpected fault doesn't spin every run).
  status String @default("RECEIVED")

  // Set once this booking has been turned into a real Reservation — see
  // src/lib/channels/inbound/convert.ts. SetNull rather than Cascade: if the reservation is
  // later deleted, the record that it once arrived via this channel booking should survive.
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  // Normalised fields. All nullable: a payload that fails to parse is still stored, and a
  // half-understood booking is more useful than a discarded one.
  externalRoomId String?
  roomTypeId     String?
  roomType       RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  propertyId     String?
  property       Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  guestFirstName String?
  guestLastName  String?
  guestEmail     String?
  arrival        DateTime?
  departure      DateTime?
  adults         Int?
  children       Int?
  totalAmount    Float?
  currency       String?
  // The channel's own status word (new, modified, cancelled, ...) as received.
  channelStatus  String?

  // Set when the booking could not be placed — unmapped room, unparseable dates, and so on.
  problem String?

  // TRUE when accepting this booking exceeds real availability for its room type and dates.
  // Per D-7 rule 4 the booking is still accepted — the channel manager already confirmed it
  // to the guest, so refusing is not genuinely available to us — but it must be surfaced as
  // an exception the desk resolves, NOT folded in silently as a deliberate manual overbook.
  isOverbooking    Boolean   @default(false)
  overbookingNote  String?
  acknowledgedAt   DateTime?
  acknowledgedById String?

  // Exactly as received. Never redacted: a booking payload carries guest details, not
  // credentials, and the raw body is what makes a mis-parse recoverable.
  rawPayload String

  receivedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([connectionId, externalBookingId])
  @@index([enterpriseId, receivedAt])
  @@index([enterpriseId, isOverbooking])

  @@index([propertyId])
  @@index([reservationId])
  @@index([roomTypeId])
}

// Per-link defaults for converting a ChannelInboundBooking into a real Reservation — what to
// pick when the channel manager's payload doesn't say. A channel booking confirms a stay and
// a price; it does not name one of THIS property's rate plans or meal plans, so conversion
// has nothing to attach the booking to without an operator having configured one. Configured
// once per link (Hub > Mapping > Defaults tab), not guessed per booking.
model ChannelBookingDefaults {
  id     String              @id @default(uuid())
  linkId String              @unique
  link   ChannelPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  // Which of this property's rate plans an inbound booking attaches to for
  // allocation/Night Audit purposes. Null means conversion cannot proceed yet — see
  // resolveBookingDefaults() in src/lib/channels/defaults.ts — so a booking with no
  // configured default is flagged for the desk rather than guessed at.
  ratePlanId String?
  ratePlan   RatePlan? @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)

  // Reservation.mealPlan is an untyped string defaulting to "NONE" everywhere else in the
  // app (see POST /api/reservations) — this follows the same convention rather than
  // inventing a stricter rule only for the channel path.
  mealPlanCode String @default("NONE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ratePlanId])
}
