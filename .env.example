# Copy to .env and fill in. .env is gitignored.

# SQLite database file (Prisma). See prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# JWT signing secret for session cookies. REQUIRED in production — the app refuses to boot
# without it in prod (src/lib/jwt-secret.ts); a dev fallback is used only outside production.
JWT_SECRET="change_me"

# Key for encrypting tenant secrets at rest (SMTP/SFTP passwords), AES-256-GCM. Any string;
# it is hashed to a 32-byte key. Keep it STABLE once set — rotating it makes previously
# encrypted values unreadable. If unset, those secrets are stored as plaintext (the legacy
# behavior; encryption is simply off). See src/lib/secret-crypto.ts.
SECRETS_ENCRYPTION_KEY="change_me"
