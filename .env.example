# Copy to .env and fill in. .env is gitignored.

# PostgreSQL (Prisma). See prisma/schema.prisma. This default matches the container in
# docker-compose.dev.yml — start it with:
#   docker compose -f docker-compose.dev.yml up -d
DATABASE_URL="postgresql://osta:devpass@localhost:55432/ostastay"

# JWT signing secret for session cookies. REQUIRED in production — the app refuses to boot
# without it in prod (src/lib/jwt-secret.ts); a dev fallback is used only outside production.
JWT_SECRET="change_me"

# Key for encrypting tenant secrets at rest (SMTP/SFTP passwords), AES-256-GCM. Any string;
# it is hashed to a 32-byte key. Keep it STABLE once set — rotating it makes previously
# encrypted values unreadable. If unset, those secrets are stored as plaintext (the legacy
# behavior; encryption is simply off). See src/lib/secret-crypto.ts.
SECRETS_ENCRYPTION_KEY="change_me"

# Shared secret for the background job runner (/api/jobs/run), called by an external cron.
# The endpoint FAILS CLOSED: with this unset it refuses every request rather than running
# unauthenticated. Generate a long random value, e.g. `openssl rand -hex 32`.
# See src/lib/jobs/ — jobs keep channel-manager credentials alive (Beds24 refresh tokens
# die after 30 days idle) and prune the channel-manager exchange log.
CRON_SECRET="change_me"

# This app's own public base URL — used server-side to build absolute guest-facing links
# (eRegistration email/copy-link) that can't be reliably inferred from request headers
# across every deployment/proxy shape. No trailing slash.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Platform SMTP — the sender for mail that comes FROM UPPSOLUT STAY ITSELF:
# enterprise handover credentials and channel-manager alerts.
#
# This is NOT where a hotel's guest mail is configured. Confirmation letters,
# eRegistration links and debtor statements go out through the TENANT's own SMTP,
# which each enterprise sets under Controls > Reports > SMTP / SFTP so the mail
# comes from their own domain. The two senders are independent — see
# src/lib/mailer.ts.
#
# Leave these unset and platform mail is simply off: onboarding still works and
# still shows the credentials on screen for manual handover, and channel alerts
# are not sent. Nothing else changes.
#
# Amazon SES note: verify the sending DOMAIN in the same region as the endpoint,
# and check the account is out of the SES sandbox — a sandboxed account
# authenticates normally and then rejects every unverified recipient.
PLATFORM_SMTP_HOST="email-smtp.eu-north-1.amazonaws.com"
# 587 = STARTTLS (default), 465 = implicit TLS.
PLATFORM_SMTP_PORT="587"
PLATFORM_SMTP_USERNAME="change_me"
PLATFORM_SMTP_PASSWORD="change_me"
# Must be an address the provider has verified for sending.
PLATFORM_SMTP_FROM_ADDRESS="noreply@mail.example.com"
# Display name on the From header. Defaults to "Uppsolut Stay".
PLATFORM_SMTP_FROM_NAME="Uppsolut Stay"
# Set to "false" ONLY for a relay that cannot do STARTTLS on a non-465 port.
PLATFORM_SMTP_USE_TLS="true"

# Where channel-manager failure alerts go — the platform ops mailbox, not the tenant
# (the Beds24 account is Uppsolut's, so only we can re-authorize a lapsed connection).
# Comma-separated. Empty means channel alerting is off.
PLATFORM_ALERT_EMAIL=""
